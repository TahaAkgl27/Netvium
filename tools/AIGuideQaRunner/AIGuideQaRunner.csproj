<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AIGuideQaRunner</AssemblyName>
    <RootNamespace>AIGuideQaRunner</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Netvium.csproj">
      <Properties>OutputPath=$(MSBuildThisFileDirectory)..\..\bin\qa-staging\;UseAppHost=false</Properties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="TestData\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
