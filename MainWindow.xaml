                                                Margin="16"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Background="#101827"
                                                BorderBrush="#31425F"
                                                BorderThickness="1"
                                                CornerRadius="18"
                                                Padding="14"
                                                PreviewMouseWheel="OnDashExpandPreviewMouseWheel"
                                                MouseLeftButtonDown="OnDashExpandModalMouseDown">
