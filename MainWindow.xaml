                                                                        <Border Background="#1E2A3F" CornerRadius="3" />
                                                                        <Border x:Name="ServerOverviewDiskBarFill" Background="#FBBF24" CornerRadius="3" HorizontalAlignment="Left" Width="0" />
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
