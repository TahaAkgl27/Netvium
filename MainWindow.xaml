<Window x:Class="Netvium.MainWindow" Closing="Window_Closing"
        Icon="pack://application:,,,/NetviumLogo.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Netvium"
        xmlns:models="clr-namespace:Netvium.Models"
        xmlns:aiguide="clr-namespace:Netvium.Models.AIGuide"
        xmlns:helpers="clr-namespace:Netvium.Helpers"
        xmlns:vm="clr-namespace:Netvium.ViewModels"
        xmlns:dash="clr-namespace:Netvium.Views.Dashboard"
        xmlns:licensing="clr-namespace:Netvium.Views.Licensing"
        xmlns:rdpview="clr-namespace:Netvium.Views"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        mc:Ignorable="d"
        Title="Netvium"
        Height="900"
        Width="1400"
        MinWidth="1200"
        MinHeight="720"
        WindowState="Maximized"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>

        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate DataType="{x:Type vm:DashboardTabContentViewModel}">
            <Grid Background="Transparent" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RdpSessionViewModel}">
            <Grid HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="Black">
                <ContentPresenter Content="{Binding SessionView}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" />
            </Grid>
        </DataTemplate>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#D6D9E0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="Transparent">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="6,4">
                                    <DockPanel>
                                        <Path Width="10" Height="10" Margin="0,0,8,0" Fill="{StaticResource MutedTextBrush}"
                                              Data="M 0 0 L 6 5 L 0 10 Z">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" CenterX="3" CenterY="5" />
                                            </Path.RenderTransform>
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="90" CenterX="3" CenterY="5" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="{TemplateBinding Header}" FontWeight="SemiBold" />
                                    </DockPanel>
                                </ToggleButton>
                                <ContentPresenter Margin="0,6,0,0" x:Name="ExpanderContent" Visibility="Collapsed" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConnectionsTreeStyle" TargetType="TreeView">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Foreground" Value="#D6D9E0" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>

        <Style x:Key="ConnectionsTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Foreground" Value="#E8ECF4" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnConnectionItemClick" />
            <EventSetter Event="MouseDoubleClick" Handler="OnConnectionDoubleClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Grid x:Name="NodeRow">
                                <Border x:Name="SelectionBorder"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="2,0"
                                        Padding="6,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ToggleButton x:Name="Expander"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Width="16" Height="16"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent">
                                                        <Path x:Name="Arrow"
                                                              Width="8" Height="8"
                                                              Fill="{StaticResource MutedTextBrush}"
                                                              Data="M 0 0 L 6 4 L 0 8 Z"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0" CenterX="3" CenterY="4" />
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="90" CenterX="3" CenterY="4" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Arrow" Property="Fill" Value="White" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>

                                        <ContentPresenter x:Name="IconHost" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                        <ContentPresenter x:Name="PART_Header"
                                                          Grid.Column="2"
                                                          ContentSource="Header"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"
                                                          Margin="4,0,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" Margin="20,2,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="#121A2A" />
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="2,0,0,0" />
                                <Setter TargetName="SelectionBorder" Property="CornerRadius" Value="0" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" SourceName="NodeRow" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SelectionBorder" Property="Background" Value="#1F2937" />
                            </MultiTrigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TreeNodeContextMenuItemStyle" TargetType="MenuItem">
            <EventSetter Event="Click" Handler="OnAddServerToNodeClick" />
        </Style>

        <ContextMenu x:Key="SessionRowContextMenu" x:Shared="False" Style="{StaticResource NetviumContextMenu}">
            <MenuItem Style="{StaticResource NetviumMenuItem}" Click="OnLogoffSessionClick">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" Style="{StaticResource NetviumMenuIcon}" />
                        <TextBlock Text="Log Off Session" VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="ServiceRowContextMenu" x:Shared="False" Style="{StaticResource NetviumContextMenu}">
            <MenuItem Style="{StaticResource NetviumMenuItem}" Click="OnStartServiceClick">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource NetviumMenuIcon}" />
                        <TextBlock Text="Start Service" VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Style="{StaticResource NetviumMenuItem}" Click="OnStopServiceClick">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" Style="{StaticResource NetviumMenuIcon}" />
                        <TextBlock Text="Stop Service" VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Style="{StaticResource NetviumMenuItem}" Click="OnRestartServiceClick">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource NetviumMenuIcon}" />
                        <TextBlock Text="Restart Service" VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="MainHeaderRow" Height="52" />
            <RowDefinition x:Name="MainContentRow" Height="*" />
            <RowDefinition x:Name="MainStatusRow" Height="32" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftSidebarColumn" Width="320" MinWidth="280" />
            <ColumnDefinition x:Name="LeftSidebarSplitterColumn" Width="4" />
            <ColumnDefinition Width="*" MinWidth="400" />
            <ColumnDefinition x:Name="AiSplitterColumn" Width="4" />
            <ColumnDefinition x:Name="AiPanelColumn" Width="0" MinWidth="0" MaxWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- HEADER -->
        <Border x:Name="MainHeaderBorder" Grid.Row="0" Grid.ColumnSpan="5" Background="{StaticResource TopBarBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="10" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0" />
                                <GradientStop Color="#7C3AED" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image Source="pack://application:,,,/NetviumLogo.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="Netvium" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    <Border Background="#151C28" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1">
                        <TextBlock Text="v3" FontSize="10" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <Grid Grid.Column="1" Margin="32,8,32,8" MaxWidth="520" HorizontalAlignment="Center">
                    <TextBox x:Name="GlobalSearchBox"
                             Style="{StaticResource HeaderSearchBox}"
                             Height="38"
                             Tag="Sunucu, IP veya klasör ara..."
                             TextChanged="OnGlobalSearchChanged" />
                    <Border Background="#151C28"
                            CornerRadius="6"
                            Padding="7,3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            BorderBrush="#243044"
                            BorderThickness="1"
                            IsHitTestVisible="False">
                        <TextBlock Text="Ctrl+K" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                    </Border>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AdminHeaderButton" Style="{StaticResource FilterTabButton}" ToolTip="Admin License Console" Margin="0,0,8,0" Padding="10,6" Click="OnOpenAdminConsoleClick" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#FBBF24" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Admin" FontSize="12" FontWeight="SemiBold" Foreground="#E8EDF5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PlansHeaderButton" Style="{StaticResource FilterTabButton}" ToolTip="Plans &amp; Licensing" Margin="0,0,8,0" Padding="10,6" Click="OnOpenPlansClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" Foreground="#A78BFA" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Plans" FontSize="12" FontWeight="SemiBold" Foreground="#E8EDF5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Grid Width="38" Height="36" Margin="0,0,4,0">
                        <Button x:Name="NotificationsButton"
                                Style="{StaticResource IconToolbarButton}"
                                Content="&#xEA8F;"
                                FontFamily="Segoe MDL2 Assets"
                                ToolTip="Notifications"
                                Margin="0"
                                Click="OnNotificationsClick" />
                        <Border x:Name="NotificationBadge"
                                MinWidth="17" Height="17"
                                Padding="4,0"
                                Background="#EF4444"
                                BorderBrush="#0A0E16"
                                BorderThickness="2"
                                CornerRadius="9"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-2,-2,0"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <TextBlock x:Name="NotificationBadgeText"
                                       Text="0"
                                       Foreground="White"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <Popup x:Name="NotificationsPopup"
                               PlacementTarget="{Binding ElementName=NotificationsButton}"
                               Placement="Bottom"
                               HorizontalOffset="-350"
                               VerticalOffset="8"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Width="400"
                                    Background="#101725"
                                    BorderBrush="#2A3850"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="0"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="10" Opacity="0.48" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Margin="18,16,18,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="NotificationPanelTitle" Text="Notification Center" Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock x:Name="NotificationPanelSubtitle" Text="Live alert feed" Foreground="#7F8DA3" FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#1A2744" CornerRadius="10" Padding="9,4" VerticalAlignment="Center">
                                            <TextBlock x:Name="NotificationCountText" Text="0 active" Foreground="#9DB7FF" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="1" Margin="14,0,14,10" Padding="10,8" Background="#0D1420" BorderBrush="#202C3F" BorderThickness="1" CornerRadius="9">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="NotificationStatusDot" Width="7" Height="7" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="NotificationStatusText" Text="Notifications enabled" Foreground="#A8B5C8" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Grid.Row="2">
                                        <ScrollViewer MaxHeight="410" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,0,10,6">
                                            <StackPanel x:Name="NotificationItemsPanel" />
                                        </ScrollViewer>
                                        <StackPanel x:Name="NotificationEmptyState" Visibility="Collapsed" Margin="32,34" HorizontalAlignment="Center">
                                            <Border Width="44" Height="44" CornerRadius="22" Background="#172235" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#64748B" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Name="NotificationEmptyTitle" Text="No active alerts" Foreground="#DCE5F2" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                            <TextBlock x:Name="NotificationEmptyDescription" Text="Your monitored servers look healthy." Foreground="#718096" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <Button Grid.Row="3" Style="{StaticResource ModalSecondaryButton}" Margin="12,6,12,12" HorizontalAlignment="Stretch" Click="OnNotificationSettingsClick">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0" />
                                            <TextBlock x:Name="NotificationSettingsButtonText" Text="Notification settings" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Style="{StaticResource IconToolbarButton}" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" ToolTip="Settings" Margin="0,0,12,0" Click="OnOpenSettingsClick" />
                    <Button x:Name="HeaderAccountButton" Style="{StaticResource FilterTabButton}" ToolTip="Hesabına giriş yap"
                            Margin="0,0,8,0" Padding="10,6" Click="OnAccountAccessClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#8EA8FF"
                                       FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Giriş yap" FontSize="12" FontWeight="SemiBold" Foreground="#E8EDF5"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Background="#151C28" CornerRadius="12" Padding="10,6" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" MaxWidth="250">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentBrush}" Margin="0,0,8,0">
                                <TextBlock x:Name="HeaderUserInitials" Text="NV" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderUserNameText" Text="Netvium" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="175" />
                                <TextBlock x:Name="HeaderUserRoleText" Text="" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="175" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button x:Name="HeaderLogoutButton" Style="{StaticResource IconToolbarButton}" Content="&#xF3B1;" FontFamily="Segoe MDL2 Assets" ToolTip="Çıkış yap" Margin="6,0,0,0" Click="OnAccountLogoutClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="LeftSidebarBorder" Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,1,0">
            <Grid Margin="14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Mini status row -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                    <Border Style="{StaticResource SidebarStatChipServers}" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Servers" Style="{StaticResource SidebarStatChipLabel}" Foreground="#94A3B8" />
                            <TextBlock x:Name="SidebarTotalText" Text="0" Style="{StaticResource SidebarStatChipValue}" Foreground="#E2E8F0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SidebarStatChipHealthy}" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#4ADE80" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Healthy" Style="{StaticResource SidebarStatChipLabel}" Foreground="#86EFAC" />
                            <TextBlock x:Name="SidebarHealthyText" Text="0" Style="{StaticResource SidebarStatChipValue}" Foreground="#4ADE80" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SidebarStatChipWarning}" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#FBBF24" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Warning" Style="{StaticResource SidebarStatChipLabel}" Foreground="#FCD34D" />
                            <TextBlock x:Name="SidebarWarningText" Text="0" Style="{StaticResource SidebarStatChipValue}" Foreground="#F59E0B" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SidebarStatChipCritical}" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#F87171" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Critical" Style="{StaticResource SidebarStatChipLabel}" Foreground="#FCA5A5" />
                            <TextBlock x:Name="SidebarCriticalText" Text="0" Style="{StaticResource SidebarStatChipValue}" Foreground="#EF4444" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Header -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Connections" FontWeight="SemiBold" FontSize="18" Foreground="White" />
                        <TextBlock Text="Folder / Host list" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Content="+ Add" Padding="12,6" FontSize="11" Click="OnOpenAddPanelClick" ToolTip="Add Server" />
                        <Button Style="{StaticResource SidebarIconSquareButton}" Content="&#xE8B7;" Margin="6,0,0,0" ToolTip="Expand folders" Click="OnExpandAllFoldersClick" />
                        <Button Style="{StaticResource SidebarIconSquareButton}" Content="&#xE8FD;" Margin="4,0,0,0" ToolTip="Collapse folders" Click="OnCollapseAllFoldersClick" />
                    </StackPanel>
                </Grid>

                <!-- Search + toolbar + tree -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SidebarSearchBox"
                             Grid.Row="0"
                             Style="{StaticResource SearchBox}"
                             Height="38"
                             Margin="0,0,0,8"
                             Tag="Bağlantı veya IP ara..."
                             TextChanged="OnSidebarSearchChanged" />

                    <Border Grid.Row="1" Style="{StaticResource SidebarQuickToolbarShell}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="SidebarConnectButton"
                                    Grid.Column="0"
                                    Style="{StaticResource SidebarQuickToolbarButtonAccent}"
                                    Click="OnConnectSelectedClick"
                                    ToolTip="Seçili sunucuya bağlan">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8FB;" Style="{StaticResource SidebarQuickToolbarIcon}" />
                                    <TextBlock Text="Connect" Style="{StaticResource SidebarQuickToolbarLabel}" />
                                </StackPanel>
                            </Button>
                            <Border Grid.Column="1" Style="{StaticResource SidebarQuickToolbarDivider}" />

                            <Button Grid.Column="2"
                                    Style="{StaticResource SidebarQuickToolbarButtonDanger}"
                                    Click="OnDisconnectClick"
                                    ToolTip="Bağlantıyı kes">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource SidebarQuickToolbarIcon}" />
                                    <TextBlock Text="Kes" Style="{StaticResource SidebarQuickToolbarLabel}" />
                                </StackPanel>
                            </Button>
                            <Border Grid.Column="3" Style="{StaticResource SidebarQuickToolbarDivider}" />

                            <Button Grid.Column="4"
                                    Style="{StaticResource SidebarQuickToolbarButton}"
                                    Click="OnSortConnectionsClick"
                                    ToolTip="Bağlantıları sırala">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8CB;" Style="{StaticResource SidebarQuickToolbarIcon}" />
                                    <TextBlock Text="Sort" Style="{StaticResource SidebarQuickToolbarLabel}" />
                                </StackPanel>
                            </Button>
                            <Border Grid.Column="5" Style="{StaticResource SidebarQuickToolbarDivider}" />

                            <Button Grid.Column="6"
                                    Style="{StaticResource SidebarQuickToolbarButton}"
                                    Click="OnScanAllClick"
                                    ToolTip="Tüm sunucuları tara">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource SidebarQuickToolbarIcon}" />
                                    <TextBlock Text="Yenile" Style="{StaticResource SidebarQuickToolbarLabel}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border x:Name="FavoritesSection" Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="0,0,0,8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="★ Favoriler" FontWeight="SemiBold" FontSize="12" Foreground="#FBBF24" Margin="0,0,0,6" />
                            <ItemsControl x:Name="FavoritesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="4,5" Margin="0,1" Cursor="Hand" MouseLeftButtonUp="OnFavoriteItemClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FBBF24" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#64748B" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="12" Padding="4,6">
                        <TreeView x:Name="ConnectionsTree"
                                  Style="{StaticResource ConnectionsTreeStyle}"
                                  ItemContainerStyle="{StaticResource ConnectionsTreeItemStyle}"
                                  SelectedItemChanged="OnConnectionSelected"
                                  BorderThickness="0">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Border Margin="0,1" CornerRadius="6" Padding="2,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="2,0,0,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActiveDashboard}" Value="True">
                                                        <Setter Property="Background" Value="#121A2A" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Background="Transparent">
                                        <Grid.ContextMenu>
                                            <ContextMenu Style="{StaticResource NetviumContextMenu}">
                                                <MenuItem Style="{StaticResource NetviumMenuItem}" Click="OnAddServerToNodeClick">
                                                    <MenuItem.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8FB;" Style="{StaticResource NetviumMenuIcon}" />
                                                            <TextBlock Text="Add server to folder" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </MenuItem.Header>
                                                </MenuItem>
                                                <MenuItem Style="{StaticResource NetviumMenuItem}" Click="OnToggleFavoriteFromMenuClick">
                                                    <MenuItem.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE734;" Style="{StaticResource NetviumMenuIcon}" Foreground="#FBBF24" />
                                                            <TextBlock Text="Favorilere Ekle / Kaldir" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </MenuItem.Header>
                                                </MenuItem>
                                                <MenuItem Style="{StaticResource NetviumMenuItemDanger}" Click="OnRemoveNodeClick">
                                                    <MenuItem.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE74D;" Style="{StaticResource NetviumMenuIcon}" Foreground="#F87171" />
                                                            <TextBlock Text="Sil" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </MenuItem.Header>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Margin="0,0,8,0" Width="14">
                                            <TextBlock x:Name="NodeIcon" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" />
                                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                                <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#FBBF24" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle}" Foreground="#64748B" FontSize="12" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Subtitle}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Subtitle}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Style="{StaticResource SidebarTreeMenuButton}"
                                                Click="OnConnectionItemMenuClick"
                                                Tag="{Binding}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                    </Border>
                                    <HierarchicalDataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Server}" Value="{x:Null}">
                                            <Setter TargetName="NodeIcon" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </HierarchicalDataTemplate.Triggers>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Border>
                </Grid>

                <!-- Quick connect -->
                <Border Grid.Row="3" Style="{StaticResource SidebarQuickConnectCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12" Cursor="Hand" MouseLeftButtonUp="OnToggleQuickConnectPanel">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" CornerRadius="8" Background="#1A2744" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Quick Connect" FontWeight="SemiBold" FontSize="13" Foreground="#F1F5F9" />
                                    <TextBlock Text="Hızlı RDP bağlantısı" FontSize="10" Foreground="#64748B" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Border Width="28" Height="28" CornerRadius="8" Background="#111827" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="QuickConnectChevron" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <StackPanel x:Name="QuickConnectBody">
                            <TextBlock Text="Host / IP" Style="{StaticResource SidebarFieldLabel}" />
                            <ComboBox x:Name="QuickHostHistoryCombo"
                                      Style="{StaticResource SidebarFormComboBox}"
                                      IsEditable="True"
                                      Margin="0,0,0,12"
                                      SelectionChanged="OnQuickHostHistorySelectionChanged"
                                      LostFocus="OnQuickHostHistoryLostFocus" />

                            <TextBlock Text="Username" Style="{StaticResource SidebarFieldLabel}" />
                            <TextBox x:Name="QuickUserBox" Style="{StaticResource SidebarFormTextBox}" />

                            <TextBlock Text="Password" Style="{StaticResource SidebarFieldLabel}" />
                            <PasswordBox x:Name="QuickPassBox" Style="{StaticResource SidebarFormPasswordBox}" />

                            <CheckBox x:Name="QuickSaveToListCheckBox"
                                      Style="{StaticResource SidebarQuickConnectCheckBox}"
                                      Content="Listeye Kaydet"
                                      Margin="0,0,0,14" />

                            <Button Style="{StaticResource SidebarQuickConnectButton}" Click="OnQuickConnectClick">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Baglan" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Legacy config fields (tree selection sync) -->
                            <TextBox x:Name="ConfigNameBox" Visibility="Collapsed" LostFocus="OnConfigLostFocus" />
                            <TextBox x:Name="ConfigHostBox" Visibility="Collapsed" LostFocus="OnConfigLostFocus" />
                            <TextBox x:Name="ConfigUserBox" Visibility="Collapsed" LostFocus="OnConfigLostFocus" />
                            <PasswordBox x:Name="ConfigPassBox" Visibility="Collapsed" LostFocus="OnConfigLostFocus" />
                            <TextBox x:Name="ConfigFolderBox" Visibility="Collapsed" LostFocus="OnConfigLostFocus" />
                            <TextBox x:Name="ConfigPortBox" Visibility="Collapsed" LostFocus="OnConfigLostFocus" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Hidden for code-behind -->
                <TextBlock x:Name="ConnectionStatusText" Visibility="Collapsed" />
                <Border x:Name="PremiumPromoCard" Visibility="Collapsed" />
            </Grid>
        </Border>

        <GridSplitter x:Name="LeftSidebarSplitter" Grid.Row="1"
                      Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="True"
                      DragStarted="OnRdpGridSplitterDragStarted"
                      DragCompleted="OnRdpGridSplitterDragCompleted" />

        <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource BackgroundBrush}" x:Name="RdpColumnBorder" Margin="0" Padding="12,8">
            <Grid x:Name="MainContentGrid" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="RdpDashboardRow" Height="0" />
                    <RowDefinition x:Name="RdpActiveConnectionRow" Height="Auto" />
                    <RowDefinition x:Name="RdpToolbarRow" Height="Auto" />
                    <RowDefinition x:Name="RdpWorkspaceRow" Height="*" MinHeight="500" />
                    <RowDefinition x:Name="RdpBottomChromeRow" Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Active Connection Toolbar -->
                <Border x:Name="ActiveConnectionHeader" Grid.Row="1" Style="{StaticResource SessionToolbarShell}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Session identity -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="3" Height="36" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3B82F6" Offset="0" />
                                        <GradientStop Color="#7C3AED" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Active Connection" FontWeight="SemiBold" FontSize="14" Foreground="White" VerticalAlignment="Center" />
                                    <Border x:Name="ActiveConnectionBadge" CornerRadius="20" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center" Background="#122A1A" BorderBrush="#223B82F6" BorderThickness="1" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Connected" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel x:Name="ActiveConnectionInfoPanel" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="ActiveConnStatusText" Text="Sunucu" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text=" · " Foreground="#334155" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ActiveConnIpText" Text="" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Waiting for connection..." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" Opacity="0.7">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=ActiveConnectionInfoPanel}" Value="Visible">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- RDP Smart Session Toolbar -->
                <Border x:Name="ExtraIconToolbar" Grid.Row="2" CornerRadius="14" Padding="10,8" Margin="0,0,0,4"
                        BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#0A101A" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.12" Color="#000000" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0D1522" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.45" Color="#6C8FF0" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <!-- Clipboard -->
                        <Grid Margin="0,0,2,0">
                            <Button Style="{StaticResource RdpSmartToolbarButton}"
                                    Command="{Binding ToggleClipboardMenuCommand}"
                                    helpers:RdpToolbarAssist.IsActive="{Binding IsClipboardMenuOpen}"
                                    IsEnabled="{Binding IsClipboardEnabled}"
                                    ToolTipService.ShowDuration="60000"
                                    ToolTip="{Binding ClipboardTooltip}">
                                <TextBlock Text="&#xE16D;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                            </Button>
                            <Popup Placement="Bottom" StaysOpen="False"
                                   IsOpen="{Binding IsClipboardMenuOpen, Mode=TwoWay}"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Style="{StaticResource RdpToolbarFlyout}">
                                    <StackPanel>
                                        <TextBlock Text="Clipboard" Foreground="White" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                                        <Button Style="{StaticResource RdpToolbarMenuItemButton}" Content="Copy" Command="{Binding ClipboardCopyCommand}" />
                                        <Button Style="{StaticResource RdpToolbarMenuItemButton}" Content="Paste" Command="{Binding ClipboardPasteCommand}" />
                                        <Button Style="{StaticResource RdpToolbarMenuItemButton}" Content="File transfer" Command="{Binding ClipboardFileTransferCommand}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Ctrl+Alt+Del -->
                        <Button Style="{StaticResource RdpSmartToolbarButton}"
                                Command="{Binding SendCtrlAltDelCommand}"
                                helpers:RdpToolbarAssist.IsLoading="{Binding IsSendingCad}"
                                IsEnabled="{Binding IsCtrlAltDelEnabled}"
                                ToolTipService.ShowDuration="60000"
                                ToolTip="{Binding CtrlAltDelTooltip}">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                        </Button>

                        <!-- Focus Mode -->
                        <Button Style="{StaticResource RdpSmartToolbarButton}"
                                Command="{Binding ToggleFocusModeCommand}"
                                helpers:RdpToolbarAssist.IsActive="{Binding IsFocusModeActive}"
                                IsEnabled="{Binding IsFocusModeEnabled}"
                                ToolTipService.ShowDuration="60000"
                                ToolTip="{Binding FocusModeTooltip}">
                            <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                        </Button>

                        <!-- Session Settings -->
                        <Grid Margin="0,0,2,0">
                            <Button Style="{StaticResource RdpSmartToolbarButton}"
                                    Command="{Binding ToggleSessionSettingsCommand}"
                                    helpers:RdpToolbarAssist.IsActive="{Binding IsSessionSettingsOpen}"
                                    IsEnabled="{Binding IsSessionSettingsEnabled}"
                                    ToolTipService.ShowDuration="60000"
                                    ToolTip="{Binding SessionSettingsTooltip}">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                            </Button>
                            <Popup Placement="Bottom" StaysOpen="False"
                                   IsOpen="{Binding IsSessionSettingsOpen, Mode=TwoWay}"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Style="{StaticResource RdpSettingsPanel}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <Border Width="32" Height="32" CornerRadius="10" Background="#1A2744" Margin="0,0,10,0">
                                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                           Foreground="#A5B4FC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RdpSettingsTitle}" Text="Session Settings" />
                                                <TextBlock Style="{StaticResource RdpSettingsSubtitle}" Text="Performance and input" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource RdpToolbarSectionHeader}" Text="PERFORMANS" Margin="0,12,0,8" />
                                        <UniformGrid Columns="3">
                                            <Button Content="Low" Command="{Binding SetPerformanceCommand}" CommandParameter="Low" Margin="0,0,6,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RdpSettingsChipButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PerformanceLevel}" Value="Low">
                                                                <Setter Property="Background" Value="#1A2D52" />
                                                                <Setter Property="Foreground" Value="#A5B4FC" />
                                                                <Setter Property="BorderBrush" Value="#3B5CCC" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Balanced" Command="{Binding SetPerformanceCommand}" CommandParameter="Balanced" Margin="0,0,6,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RdpSettingsChipButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PerformanceLevel}" Value="Balanced">
                                                                <Setter Property="Background" Value="#1A2D52" />
                                                                <Setter Property="Foreground" Value="#A5B4FC" />
                                                                <Setter Property="BorderBrush" Value="#3B5CCC" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="High" Command="{Binding SetPerformanceCommand}" CommandParameter="High">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RdpSettingsChipButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PerformanceLevel}" Value="High">
                                                                <Setter Property="Background" Value="#1A2D52" />
                                                                <Setter Property="Foreground" Value="#A5B4FC" />
                                                                <Setter Property="BorderBrush" Value="#3B5CCC" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </UniformGrid>

                                        <Border Style="{StaticResource RdpSettingsDivider}" />
                                        <TextBlock Style="{StaticResource RdpToolbarSectionHeader}" Text="INPUT" Margin="0,0,0,8" />

                                        <Button Style="{StaticResource RdpSettingsRowButton}" Command="{Binding ToggleClipboardSyncCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Pano senkronizasyonu" Foreground="#E2E8F0" FontSize="12" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource RdpSettingsStatusPill}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ClipboardSyncEnabled}" Value="True">
                                                                    <Setter Property="Background" Value="#122A1A" />
                                                                    <Setter Property="BorderBrush" Value="#166534" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="SemiBold" Margin="0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Off" />
                                                                <Setter Property="Foreground" Value="#94A3B8" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ClipboardSyncEnabled}" Value="True">
                                                                        <Setter Property="Text" Value="On" />
                                                                        <Setter Property="Foreground" Value="#4ADE80" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <Button Style="{StaticResource RdpSettingsRowButton}" Command="{Binding ToggleCaptureKeyboardCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Klavye yakalama" Foreground="#E2E8F0" FontSize="12" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource RdpSettingsStatusPill}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CaptureKeyboard}" Value="True">
                                                                    <Setter Property="Background" Value="#122A1A" />
                                                                    <Setter Property="BorderBrush" Value="#166534" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Off" />
                                                                <Setter Property="Foreground" Value="#94A3B8" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CaptureKeyboard}" Value="True">
                                                                        <Setter Property="Text" Value="On" />
                                                                        <Setter Property="Foreground" Value="#4ADE80" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <Button Style="{StaticResource RdpSettingsRowButton}" Command="{Binding ToggleCaptureMouseCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Fare yakalama" Foreground="#E2E8F0" FontSize="12" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource RdpSettingsStatusPill}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CaptureMouse}" Value="True">
                                                                    <Setter Property="Background" Value="#122A1A" />
                                                                    <Setter Property="BorderBrush" Value="#166534" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Off" />
                                                                <Setter Property="Foreground" Value="#94A3B8" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CaptureMouse}" Value="True">
                                                                        <Setter Property="Text" Value="On" />
                                                                        <Setter Property="Foreground" Value="#4ADE80" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Border Width="1" Height="22" Background="#1E293B" Margin="4,0,10,0" VerticalAlignment="Center" />

                        <!-- Risk Analysis -->
                        <Button Style="{StaticResource RdpSmartToolbarButton}"
                                Command="{Binding OpenRiskAnalysisCommand}"
                                IsEnabled="{Binding IsRiskAnalysisEnabled}"
                                ToolTipService.ShowDuration="60000"
                                ToolTip="{Binding RiskAnalysisTooltip}">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#FBBF24" />
                        </Button>

                        <!-- Event Search -->
                        <Grid Margin="0,0,2,0">
                            <Button Style="{StaticResource RdpSmartToolbarButton}"
                                    Command="{Binding ToggleEventSearchCommand}"
                                    helpers:RdpToolbarAssist.IsActive="{Binding IsEventSearchOpen}"
                                    IsEnabled="{Binding IsEventSearchEnabled}"
                                    ToolTipService.ShowDuration="60000"
                                    ToolTip="{Binding EventSearchTooltip}">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                            </Button>
                            <Popup Placement="Bottom" StaysOpen="False"
                                   IsOpen="{Binding IsEventSearchOpen, Mode=TwoWay}"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Style="{StaticResource RdpToolbarFlyout}" MinWidth="360" MaxWidth="440" Padding="16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Event Log" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="Canlı olaylarda ara" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Background="#152033"
                                                    CornerRadius="6"
                                                    Padding="7,3"
                                                    BorderBrush="#243044"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding FilteredEventCount, StringFormat='{}{0} sonuç'}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="#94A3B8" />
                                            </Border>
                                        </Grid>

                                        <TextBox Style="{StaticResource SearchBox}"
                                                 Height="38"
                                                 Margin="0,0,0,12"
                                                 Text="{Binding EventSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Mesaj, seviye veya tip ara..." />

                                        <ListBox MaxHeight="300"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemsSource="{Binding FilteredEvents}">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,6" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="ItemBd"
                                                                        Background="#121A28"
                                                                        BorderBrush="#1E293B"
                                                                        BorderThickness="1"
                                                                        CornerRadius="10"
                                                                        Padding="12,10"
                                                                        SnapsToDevicePixels="True">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ItemBd" Property="Background" Value="#162033" />
                                                                        <Setter TargetName="ItemBd" Property="BorderBrush" Value="#334155" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="ItemBd" Property="BorderBrush" Value="#3B82F6" />
                                                                        <Setter TargetName="ItemBd" Property="Background" Value="#15243A" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:TimelineEvent}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="6" Height="6"
                                                                CornerRadius="3"
                                                                Background="#3B82F6"
                                                                VerticalAlignment="Top"
                                                                Margin="0,5,10,0" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Message}"
                                                                       Foreground="#E8ECF4"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="16" />
                                                            <TextBlock Foreground="#64748B" FontSize="10" Margin="0,4,0,0">
                                                                <Run Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}', Mode=OneWay}" />
                                                                <Run Text=" · " />
                                                                <Run Text="{Binding Level, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Text="Eşleşen olay yok"
                                                   Foreground="#64748B"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,16,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasFilteredEvents}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Favorites -->
                        <Button Style="{StaticResource RdpSmartToolbarButton}"
                                Command="{Binding ToggleFavoriteCommand}"
                                helpers:RdpToolbarAssist.IsActive="{Binding IsFavorite}"
                                IsEnabled="{Binding IsFavoritesEnabled}"
                                ToolTipService.ShowDuration="60000"
                                ToolTip="{Binding FavoriteTooltip}"
                                Margin="0">
                            <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="15">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#94A3B8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Foreground" Value="#FBBF24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Border>

                <Grid x:Name="RdpWorkspaceGrid" Grid.Row="3" Background="Black">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="TabBarBorder" Grid.Row="0" Background="Black" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Visibility="Collapsed" Margin="0" Padding="0">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0" Padding="0">
                            <StackPanel x:Name="TabBarPanel" Orientation="Horizontal" Margin="0" />
                        </ScrollViewer>
                    </Border>

                    <Grid x:Name="RdpContentGrid" Grid.Row="1"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Margin="0" Background="Black" ClipToBounds="True"
                          MouseMove="OnRdpViewportMouseMove">

                        <!-- Central workspace: Dashboard or embedded RDP session (DataTemplate switching) -->
                        <ContentControl x:Name="CentralWorkspaceHost"
                                        Panel.ZIndex="100"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Background="Black" />

                        <!-- Floating RDP fullscreen toolbar -->
                        <Border x:Name="RdpFloatingToolbar" VerticalAlignment="Top" HorizontalAlignment="Stretch" Panel.ZIndex="300"
                                Visibility="Collapsed" Opacity="0.28" Margin="16,12,16,0" CornerRadius="14"
                                BorderBrush="#33FFFFFF" BorderThickness="1" IsHitTestVisible="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#E60B0F17" Offset="0" />
                                    <GradientStop Color="#CC121826" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.35" Color="#000000" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8,6">
                                <Button Style="{StaticResource ToolbarTextButton}" Content="&#xE72B; Geri" Click="OnExitRdpViewportFullscreenClick" Padding="12,8" Foreground="White" FontFamily="Segoe MDL2 Assets" />
                                <Border Width="1" Height="22" Background="#334155" Margin="10,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource ToolbarGlyphButton}" Content="&#xE765;" ToolTip="Ctrl+Alt+Del" Click="OnFloatingCtrlAltDelClick" />
                                <Button Style="{StaticResource ToolbarGlyphButton}" Content="&#xE72C;" ToolTip="Yenile" Click="OnRefreshInsightsClick" Margin="2,0,0,0" />
                                <Button Style="{StaticResource ToolbarGlyphButton}" Content="&#xE722;" ToolTip="Screenshot" Click="OnRdpScreenshotClick" Margin="2,0,0,0" />
                                <Border Width="1" Height="22" Background="#334155" Margin="10,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource ToolbarTextButton}" Content="Disconnect" Click="OnDisconnectClick" Padding="12,8" Foreground="#F87171" />
                                <Button Style="{StaticResource ToolbarTextButton}" Content="AI" Click="OnFloatingAiClick" Padding="12,8" Foreground="#A78BFA" Margin="4,0,0,0" />
                                <Button Style="{StaticResource ToolbarGlyphButton}" Content="&#xE740;" ToolTip="Exit fullscreen (Esc)" Click="OnExitRdpViewportFullscreenClick" Margin="4,0,0,0" />
                                <Button Style="{StaticResource ToolbarGlyphButton}" Content="&#xE712;" ToolTip="Daha fazla" Click="OnActionsClick" Margin="2,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="OpenAddPanelButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="Add Server"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="24,10"
                                Click="OnOpenAddPanelClick" 
                                Visibility="Collapsed"/>

                        <Border x:Name="RdpPlaceholder" Background="Black" CornerRadius="0" Opacity="0.92" BorderBrush="#2A3344" BorderThickness="0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="RDP connection unavailable" FontWeight="SemiBold" FontSize="14" Foreground="#CBD5E1" HorizontalAlignment="Center" />
                                <TextBlock Text="Add a server and connect." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- vCenter/ESXi style detailed dashboard -->
                        <Border x:Name="SelectedServerPanel"
                                Panel.ZIndex="50"
                                Background="#0B1220"
                                CornerRadius="0"
                                BorderBrush="#1E2A3F"
                                BorderThickness="1,0,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="0" />
                                </Grid.RowDefinitions>

                                <!-- Toolbar -->
                                <Border Grid.Row="0" Background="#111827" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,6">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <Button Style="{StaticResource TabButton}" Content="Console" Padding="10,4" Click="OnOpenConsoleClick" ToolTip="Uzak sunucuya PowerShell via PowerShell" />
                                            <Button Style="{StaticResource PrimaryButton}" Padding="12,4" Margin="12,0,0,0" Click="OnMorningCheckClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="Quick Scan" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource TabButton}" Content="Refresh" Padding="10,4" Margin="12,0,0,0" Click="OnRefreshInsightsClick" />
                                        </StackPanel>
                                        <Grid DockPanel.Dock="Right">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="LiveRefreshIndicatorRoot"
                                                    Grid.Column="0"
                                                    Visibility="Collapsed"
                                                    Opacity="0"
                                                    Margin="0,0,12,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    MaxWidth="200"
                                                    MinWidth="100">
                                                <StackPanel>
                                                    <TextBlock x:Name="LiveRefreshStatusText"
                                                               Text="Güncelleniyor %0"
                                                               FontSize="11"
                                                               Foreground="#94A3B8"
                                                               HorizontalAlignment="Right"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Grid x:Name="LiveRefreshProgressTrack" Height="4" Margin="0,5,0,0">
                                                        <Border Background="#1E293B" CornerRadius="2" />
                                                        <Border x:Name="LiveRefreshProgressFill"
                                                                Background="#3B82F6"
                                                                CornerRadius="2"
                                                                HorizontalAlignment="Left"
                                                                Width="0" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Connect" Padding="16,4" Click="OnConnectSelectedClick" />
                                            <Button Grid.Column="2" Style="{StaticResource TabButton}" Content="Disconnect" Padding="10,4" Margin="12,0,0,0" Click="OnDisconnectClick" />
                                        </Grid>
                                    </DockPanel>
                                </Border>

                                <!-- Compact server header -->
                                <Border Grid.Row="1" Margin="12,8,12,0" Background="#121A2B" BorderBrush="#1E2A3F" BorderThickness="1" CornerRadius="14" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="SelectedTitleText" Text="SUNUCU" FontSize="15" FontWeight="Bold" Foreground="#E8EDF5" />
                                                <Border x:Name="SelectedStatusBadge" Margin="8,0,0,0" Padding="8,3" CornerRadius="8" VerticalAlignment="Center" Background="#122A1A" BorderBrush="#2D6B45" BorderThickness="1">
                                                    <TextBlock x:Name="SelectedStatusText" Text="HEALTHY" FontSize="10" FontWeight="SemiBold" Foreground="#6EE7A0" />
                                                </Border>
                                                <TextBlock x:Name="HealthScoreValueText" Margin="8,0,0,0" FontSize="10" Foreground="#6B7A94" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock x:Name="SelectedOsText" Text="Microsoft Windows Server" Foreground="#6B7A94" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                                <TextBlock Text=" · " Foreground="#4B5A72" FontSize="11" />
                                                <TextBlock x:Name="SelectedDnsNameText" Text="10.0.0.1" Foreground="#4F8CFF" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Text=" · " Foreground="#4B5A72" FontSize="11" />
                                                <TextBlock Text="Uptime" Foreground="#6B7A94" FontSize="10" Margin="0,0,4,0" />
                                                <TextBlock x:Name="DashUptimeText" Text="?" Foreground="#CBD5E1" FontSize="11" />
                                                <TextBlock Text=" · " Foreground="#4B5A72" FontSize="11" Margin="4,0" />
                                                <Ellipse x:Name="DashAgentStatusDot" Width="6" Height="6" Fill="#64748B" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock x:Name="DashAgentStatusText" Text="?" Foreground="#94A3B8" FontSize="10" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="Collapsed">
                                                <TextBlock x:Name="SelectedLastLogonText" Text="-" />
                                                <TextBlock x:Name="ActiveAccountsValueText" Text="-" />
                                                <Border x:Name="HealthBadgeDot" Width="8" Height="8" CornerRadius="4" Background="#4ADE80" />
                                                <TextBlock x:Name="HealthSummaryText" Text="Loading..." />
                                                <TextBlock x:Name="HealthBreakdownText" Text="" Visibility="Collapsed" />
                                                <TextBlock x:Name="ActiveUsersBadgeText" Text="" Visibility="Collapsed" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource DashHeaderKpiCard}" Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock x:Name="HeaderCpuValue" Text="0%" FontSize="14" FontWeight="Bold" Foreground="#4F8CFF" />
                                                    <Border Height="3" CornerRadius="2" Background="#1E2A3F" Width="72" Margin="0,4,0,0">
                                                        <Border x:Name="HeaderCpuBarFill" Height="3" CornerRadius="2" HorizontalAlignment="Left" Width="0" Background="#4F8CFF" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource DashHeaderKpiCard}" Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock x:Name="HeaderRamValue" Text="0%" FontSize="14" FontWeight="Bold" Foreground="#A78BFA" />
                                                    <Border Height="3" CornerRadius="2" Background="#1E2A3F" Width="72" Margin="0,4,0,0">
                                                        <Border x:Name="HeaderRamBarFill" Height="3" CornerRadius="2" HorizontalAlignment="Left" Width="0" Background="#8B5CF6" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource DashHeaderKpiCard}" Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock x:Name="HeaderDiskValue" Text="0%" FontSize="14" FontWeight="Bold" Foreground="#FBBF24" />
                                                    <Border Height="3" CornerRadius="2" Background="#1E2A3F" Width="72" Margin="0,4,0,0">
                                                        <Border x:Name="HeaderDiskBarFill" Height="3" CornerRadius="2" HorizontalAlignment="Left" Width="0" Background="#F59E0B" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Customizable widget workspace -->
                                <Grid Grid.Row="2" Margin="12,8,12,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Margin="0,0,0,8" Background="#121A2B" BorderBrush="#1E2A3F" BorderThickness="1" CornerRadius="14" Padding="8,6">
                                        <DockPanel LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Workspace" Foreground="#6B7A94" FontSize="10" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <ComboBox x:Name="DashWorkspaceCombo" MinWidth="160" Height="30" Style="{StaticResource TopBarComboBox}" SelectionChanged="OnDashWorkspaceChanged" />
                                                <Button Style="{StaticResource FilterTabButton}" Content="+" Padding="8,3" Margin="6,0,0,0" FontSize="11" Click="OnDashWorkspaceCreateClick" ToolTip="New workspace" />
                                                <Button Style="{StaticResource FilterTabButton}" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Padding="8,3" Margin="4,0,0,0" FontSize="10" Click="OnDashWorkspaceDuplicateClick" ToolTip="Duplicate workspace" />
                                            </StackPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <StackPanel x:Name="DashEditActionsPanel" Orientation="Horizontal" Visibility="Collapsed">
                                                    <Button x:Name="DashAddWidgetBtn" Style="{StaticResource FilterTabButton}" Content="+ Add Widget" Padding="10,4" Margin="0,0,6,0" Click="OnDashAddWidgetClick" />
                                                    <Button x:Name="DashEditLayoutBtn" Style="{StaticResource FilterTabButton}" Content="Edit Layout" Padding="10,4" Margin="0,0,6,0" Click="OnDashEditLayoutClick" />
                                                    <Button x:Name="DashSaveLayoutBtn" Style="{StaticResource FilterTabButton}" Content="Save Layout" Padding="10,4" Margin="0,0,6,0" Click="OnDashSaveLayoutClick" />
                                                    <Button x:Name="DashAutoArrangeBtn" Style="{StaticResource FilterTabButton}" Content="Auto Arrange" Padding="10,4" Margin="0,0,6,0" Click="OnDashAutoArrangeClick" />
                                                    <Button x:Name="DashLockLayoutBtn" Style="{StaticResource FilterTabButton}" Content="Lock Layout" Padding="10,4" Margin="0,0,6,0" Click="OnDashLockLayoutClick" />
                                                    <Button Style="{StaticResource FilterTabButton}" Content="Reset" Padding="10,4" Margin="0,0,6,0" Click="OnDashResetLayoutClick" />
                                                    <Button Style="{StaticResource FilterTabButton}" Content="Import" Padding="10,4" Margin="0,0,6,0" Click="OnDashImportLayoutClick" />
                                                    <Button Style="{StaticResource FilterTabButton}" Content="Export" Padding="10,4" Margin="0,0,6,0" Click="OnDashExportLayoutClick" />
                                                </StackPanel>
                                                <Button x:Name="DashEditMenuBtn" Style="{StaticResource FilterTabButton}" Content="Düzenle" Padding="12,4" Click="OnDashEditMenuClick" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <Grid Grid.Row="1" x:Name="DashboardWorkspaceArea">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      CanContentScroll="False">
                                            <dash:DashboardWorkspaceHost x:Name="DashboardWorkspaceHost" />
                                        </ScrollViewer>
                                        <dash:AddWidgetPanel x:Name="DashboardAddWidgetPanel" HorizontalAlignment="Right" />

                                        <Grid x:Name="DashboardLegacyGrid" Visibility="Collapsed" Height="0" IsHitTestVisible="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- ROW 1: Status | Performance | Services/Events -->
                                    <Grid x:Name="DashMainGrid" Grid.Row="0" SizeChanged="OnDashMainGridSizeChanged">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4*" MinWidth="260" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="3.5*" MinWidth="280" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="2.5*" MinWidth="220" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="DashMainGridSpacer" Grid.Column="1" Width="10" Background="Transparent" />

                                        <!-- LEFT 40%: System Status -->
