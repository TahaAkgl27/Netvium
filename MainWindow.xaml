                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DISK KULLANIMI" Style="{StaticResource LiveMetricLabel}" />
                                    <TextBlock x:Name="LiveDiskText" Text="?" FontSize="22" FontWeight="Bold" Foreground="#34D399" />
                                </StackPanel>
                                <Polyline x:Name="LiveDiskSparkline" Grid.Column="1" Points="0,20" Stroke="#10B981" StrokeThickness="1.6" Stretch="Fill" Opacity="0.85" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Network -->
                        <Border x:Name="LiveNetworkCard" Style="{StaticResource LiveMetricCardPremium}" Margin="3,0" BorderBrush="#1E293B">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="NETWORK" Style="{StaticResource LiveMetricLabel}" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#34D399" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock x:Name="LiveNetworkUpText" Text="?" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#A78BFA" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock x:Name="LiveNetworkDownText" Text="?" FontSize="11" FontWeight="SemiBold" Foreground="#A78BFA" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="LiveNetworkText" Visibility="Collapsed" Text="?" />
                            </StackPanel>
                        </Border>

                        <!-- Uptime -->
                        <Border Style="{StaticResource LiveMetricCardPremium}" Margin="3,0" BorderBrush="#1E293B">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="UPTIME" Style="{StaticResource LiveMetricLabel}" />
                                <TextBlock x:Name="LiveUptimeText" Text="?" FontSize="18" FontWeight="Bold" Foreground="White" />
                                <TextBlock x:Name="LiveUptimeDetailText" Text="?" FontSize="10" Foreground="#64748B" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- IP -->
                        <Border Style="{StaticResource LiveMetricCardPremium}" Margin="6,0,0,0" BorderBrush="#223B82F6">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="IP ADDRESS" Style="{StaticResource LiveMetricLabel}" />
                                <TextBlock x:Name="LiveIpText" Text="?" FontSize="16" FontWeight="Bold" Foreground="#60A5FA" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <StackPanel x:Name="QuickActionsPanel">
                        <TextBlock Text="QUICK ACTIONS" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button Style="{StaticResource QuickActionPillButton}" BorderBrush="#334155" Foreground="#60A5FA" Click="OnQuickRestartClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Restart" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickActionPillButton}" BorderBrush="#334155" Foreground="#F87171" Click="OnQuickShutdownClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Shutdown" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickActionPillButton}" BorderBrush="#334155" Foreground="#34D399" Click="OnQuickPingClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Ping" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- AI Guide Panel (observation-only; never controls the computer) -->
        <Border Grid.Row="1" Grid.Column="4" x:Name="AiPanelBorder" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1,0,0,0" ClipToBounds="True">
            <Border.RenderTransform>
                <TranslateTransform X="0" Y="0" />
            </Border.RenderTransform>
            <Grid Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="AI Guide" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        <Border Background="#1A2744" CornerRadius="6" Padding="8,3" Margin="10,0,0,0">
                            <TextBlock Text="OBSERVE ONLY" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" />
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconToolbarButton}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Click="OnToggleAiPanelClick" ToolTip="Close (Ctrl+M)" />
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse x:Name="AiGuideStatusDot" Width="8" Height="8" Fill="#FBBF24" VerticalAlignment="Center" />
                            <TextBlock x:Name="AiGuideStatusText" Text="Press Ctrl+M to analyze the current screen." Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="AiGuideCaptureMetaText" Text="" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                <TextBlock x:Name="AiGuidePanelReminderText" Text="AI Guide explains the visible screen only. It never controls your computer." Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.85" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="AiGuideScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                    <StackPanel x:Name="AiGuideContentPanel">
                        <Border x:Name="AiGuideFailurePanel" Style="{StaticResource GlassPanel}" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed" BorderBrush="#7F1D1D" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="AiGuideFailureTitleText" Text="Failed" FontWeight="Bold" FontSize="11" Foreground="#F87171" Margin="0,0,0,6" />
                                <TextBlock x:Name="AiGuideFailureMainText" FontSize="11" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideFailureStageText" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideFailureAnalysisIdText" FontSize="10" Foreground="#64748B" Margin="0,0,0,4" Visibility="Collapsed" />
                                <TextBlock x:Name="AiGuideFailureDetailText" FontSize="10" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideFailureRetryText" FontSize="10" Foreground="#64748B" Text="Press Ctrl+M to retry." Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideFailureTechnicalText" FontSize="9" Foreground="#64748B" TextWrapping="Wrap" Visibility="Collapsed" FontFamily="Consolas" />
                                <StackPanel x:Name="AiGuideFailureVerboseDiagnosticsPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                    <TextBlock x:Name="AiGuideFailureExceptionTypeText" FontSize="9" Foreground="#64748B" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,0,0,2" />
                                    <TextBlock x:Name="AiGuideFailureExceptionMessageText" FontSize="9" Foreground="#64748B" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,0,0,2" />
                                    <TextBlock x:Name="AiGuideFailureOriginMethodText" FontSize="9" Foreground="#64748B" TextWrapping="Wrap" FontFamily="Consolas" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="AiGuideCaptureDiagnosticsPanel" Style="{StaticResource GlassPanel}" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed" BorderBrush="#1E3A5F" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="AiGuideCaptureDiagnosticsTitleText" Text="Capture Diagnostics" FontWeight="Bold" FontSize="10" Foreground="#64748B" Margin="0,0,0,6" />
                                <TextBlock x:Name="AiGuideCaptureDiagnosticsText" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,0,0,8" />
                                <Button Content="Copy Capture Diagnostics" Style="{StaticResource FilterTabButton}" Padding="10,6" HorizontalAlignment="Left" Click="OnCopyCaptureDiagnosticsClick" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="AiGuideMentorPanel" Style="{StaticResource GlassPanel}" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <!-- Header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="AI GUIDE" FontWeight="Bold" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border Background="#14532D" CornerRadius="6" Padding="8,3" Margin="10,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#14532D" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=AiGuideMentorStatusBadge, Path=Text}" Value="Needs Focus">
                                                        <Setter Property="Background" Value="#713F12" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ElementName=AiGuideMentorStatusBadge, Path=Text}" Value="Odak Gerekli">
                                                        <Setter Property="Background" Value="#713F12" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock x:Name="AiGuideMentorStatusBadge" Text="Screen Ready" FontSize="9" FontWeight="Bold" Foreground="#22C55E" />
                                    </Border>
                                </StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="AiGuideMentorServerText" Grid.Row="0" Grid.Column="0" FontSize="10" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,4,4" />
                                    <TextBlock x:Name="AiGuideMentorRoleText" Grid.Row="0" Grid.Column="1" FontSize="10" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="4,0,0,4" />
                                    <TextBlock x:Name="AiGuideMentorApplicationText" Grid.Row="1" Grid.Column="0" FontSize="10" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,4,4" />
                                    <TextBlock x:Name="AiGuideMentorWorkflowText" Grid.Row="1" Grid.Column="1" FontSize="10" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="4,0,0,4" />
                                    <TextBlock x:Name="AiGuideMentorConfidenceText" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" />
                                </Grid>

                                <!-- Section 1: Current Screen -->
                                <TextBlock x:Name="AiGuideSectionCurrentScreenText" Text="Current Screen" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideMentorCurrentScreenText" FontSize="11" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <!-- Section 2: Things I noticed -->
                                <TextBlock x:Name="AiGuideSectionThingsNoticedText" Text="Things I noticed" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <ItemsControl x:Name="AiGuideMentorObservationsList" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type aiguide:ObservationItem}">
                                            <TextBlock Text="{Binding Text, StringFormat='• {0}'}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Section 3: Current Workflow -->
                                <TextBlock x:Name="AiGuideSectionWorkflowText" Text="Current Workflow" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <StackPanel x:Name="AiGuideMentorWorkflowSection" Margin="0,0,0,10">
                                    <TextBlock x:Name="AiGuideMentorWorkflowNameText" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock x:Name="AiGuideMentorWorkflowStepText" FontSize="10" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                    <ProgressBar x:Name="AiGuideMentorWorkflowProgressBar" Height="6" Minimum="0" Maximum="100" Margin="0,0,0,4" />
                                    <TextBlock x:Name="AiGuideMentorWorkflowProgressText" FontSize="10" Foreground="#64748B" Margin="0,0,0,4" />
                                    <TextBlock x:Name="AiGuideMentorWorkflowConfidenceText" FontSize="10" Foreground="#22C55E" Margin="0,0,0,4" />
                                    <TextBlock x:Name="AiGuideMentorWorkflowScreenChangeText" FontSize="10" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed" />
                                    <TextBlock x:Name="AiGuideMentorWorkflowTimelineText" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <Expander x:Name="AiGuideMentorTimelineExpander" FontSize="10" Foreground="#64748B">
                                        <Expander.Header>
                                            <TextBlock x:Name="AiGuideWorkflowHistoryHeaderText" Text="Workflow history" FontSize="10" Foreground="#64748B" />
                                        </Expander.Header>
                                        <ItemsControl x:Name="AiGuideMentorTimelineList" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type aiguide:TimelineEntry}">
                                                    <TextBlock Text="{Binding Message, StringFormat='• {0}'}" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>

                                <!-- Section 4: Suggested Questions -->
                                <TextBlock x:Name="AiGuideSectionQuestionsText" Text="Suggested Questions" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6" />
                                <ItemsControl x:Name="AiGuideMentorQuestionsList" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type aiguide:QuestionSuggestion}">
                                            <Button Style="{StaticResource FilterTabButton}"
                                                    Content="{Binding Question}"
                                                    Tag="{Binding Question}"
                                                    Margin="0,0,6,6"
                                                    Padding="10,6"
                                                    Click="OnAiGuideSuggestedTopicClick"
                                                    ToolTip="Fill input with this question" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Section 5: Learn About This Screen -->
                                <TextBlock x:Name="AiGuideSectionLearnText" Text="Learn About This Screen" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6" />
                                <ItemsControl x:Name="AiGuideMentorLearningTopicsList" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type aiguide:LearningTopic}">
                                            <Button Style="{StaticResource FilterTabButton}"
                                                    Content="{Binding Label}"
                                                    Tag="{Binding TeachPrompt}"
                                                    Margin="0,0,6,6"
                                                    Padding="10,6"
                                                    Click="OnAiGuideLearningTopicClick"
                                                    ToolTip="Teach me about this topic" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Section 6: Warnings -->
                                <StackPanel x:Name="AiGuideMentorWarningsSection" Margin="0,0,0,10" Visibility="Collapsed">
                                    <TextBlock x:Name="AiGuideSectionWarningsText" Text="Warnings" FontSize="11" FontWeight="SemiBold" Foreground="#F87171" Margin="0,0,0,4" />
                                    <ItemsControl x:Name="AiGuideMentorWarningsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type aiguide:MentorWarning}">
                                                <TextBlock Text="{Binding Message, StringFormat='⚠ {0}'}" FontSize="10" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,0,0,3" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Section 7: Evidence -->
                                <Expander x:Name="AiGuideMentorEvidenceExpander" FontSize="10" Foreground="#64748B">
                                    <Expander.Header>
                                        <TextBlock x:Name="AiGuideSectionEvidenceHeaderText" Text="Evidence" FontSize="10" Foreground="#64748B" />
                                    </Expander.Header>
                                    <ItemsControl x:Name="AiGuideMentorEvidenceList" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type aiguide:MentorEvidenceItem}">
                                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2">
                                                    <Run Text="• " />
                                                    <Run Text="{Binding Label}" FontWeight="SemiBold" />
                                                    <Run Text=": " />
                                                    <Run Text="{Binding Detail}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                                <TextBlock x:Name="AiGuideMentorReminderText" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Opacity="0.9" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="AiGuideAwarenessPanel" Style="{StaticResource GlassPanel}" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="AiGuideAwarenessTitleText" Text="Context awareness" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                                <TextBlock x:Name="AiGuideAwarenessServerText" FontSize="11" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideAwarenessRoleText" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideAwarenessApplicationText" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideAwarenessConnectionText" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideAwarenessAnalysisTimeText" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideAwarenessVisionConfidenceText" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideAwarenessOverallConfidenceText" FontSize="11" Foreground="#22C55E" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="AiGuideSummaryPanel" Style="{StaticResource GlassPanel}" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="AiGuideTechnicalSummaryTitleText" Text="Technical summary" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                                <TextBlock x:Name="AiGuideApplicationText" FontSize="11" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideWindowTitleText" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideConfidenceText" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideControlsCountText" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideErrorsText" FontSize="11" Foreground="#F87171" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideWarningsText" FontSize="11" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideSourceText" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideAnalyzedAtText" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                                <TextBlock x:Name="AiGuideLimitationsText" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Style="{StaticResource FilterTabButton}" Content="Risk Analysis (WMI)" Margin="0,0,6,6" Padding="10,6" Click="OnAiPanelRiskAnalysisClick" ToolTip="Separate WMI-based analysis — not screen vision." />
                        </WrapPanel>
                        <CheckBox x:Name="AiGuideShowRawJsonCheck" Content="Show raw JSON (debug)" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed" Checked="OnAiGuideRawJsonToggle" Unchecked="OnAiGuideRawJsonToggle" />
                        <TextBox x:Name="AiGuideRawJsonBox" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120" MaxHeight="240" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10" Background="#0A101A" Foreground="#94A3B8" BorderBrush="#1E293B" Margin="0,6,0,0" />
                        <ItemsControl x:Name="AiGuideMessagesList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type aiguide:AIGuideMessage}">
                                    <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="12" MaxWidth="320">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#151C28" />
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Background" Value="#1A2744" />
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="AI Guide" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                <Setter Property="Text" Value="You" />
                                                                <Setter Property="Foreground" Value="#94A3B8" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="12" Foreground="#E2E8F0" />
                                            <Border Margin="0,8,0,0" Padding="6,2" CornerRadius="6" HorizontalAlignment="Left" Background="#0F172A">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasConfidence}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" Foreground="#94A3B8">
                                                    <Run Text="Confidence: " />
                                                    <Run Text="{Binding Confidence}" FontWeight="SemiBold" Foreground="#22C55E" />
                                                </TextBlock>
                                            </Border>
                                            <Expander Margin="0,6,0,0" FontSize="10" Foreground="#64748B">
                                                <Expander.Style>
                                                    <Style TargetType="Expander">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasEvidence}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Expander.Style>
                                                <Expander.Header>
                                                    <TextBlock Text="Visible evidence" FontSize="10" Foreground="#64748B" />
                                                </Expander.Header>
                                                <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type aiguide:GuidanceEvidence}">
                                                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2">
                                                                <Run Text="• " />
                                                                <Run Text="{Binding Label}" FontWeight="SemiBold" />
                                                                <Run Text=": " />
                                                                <Run Text="{Binding Detail}" />
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="AiGuideInputRow" Grid.Row="3">
                    <TextBlock x:Name="AiGuideInputHintText" Text="Complete screen analysis before asking a question." FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" TextWrapping="Wrap" Opacity="0.85" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AiGuideInputBox"
                                 Grid.Column="0"
                                 MinHeight="36"
                                 MaxHeight="96"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 IsEnabled="False"
                                 FontSize="12"
                                 Padding="10,8"
                                 Margin="0,0,8,0"
                                 Background="#0A101A"
                                 Foreground="#E2E8F0"
                                 BorderBrush="#1E293B"
                                 PreviewKeyDown="OnAiGuideInputPreviewKeyDown" />
                        <Button x:Name="AiGuideSendButton"
                                Grid.Column="1"
                                Style="{StaticResource FilterTabButton}"
                                Content="Send"
                                Padding="14,8"
                                VerticalAlignment="Bottom"
                                IsEnabled="False"
                                Click="OnAiGuideSendClick" />
                    </Grid>
                </StackPanel>

                <Border x:Name="AiGuideLicenseLockPanel" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Background="{StaticResource SidebarBrush}" Panel.ZIndex="30">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="280" Margin="24">
                        <Border Width="52" Height="52" CornerRadius="26" Background="#292524" BorderBrush="#92400E" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Premium+ Exclusive" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        <TextBlock Text="Live Screen Reading" FontSize="12" Foreground="#FBBF24" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock Text="Upgrade to Premium+ to enable this feature." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="View Plans" Padding="18,10" MinWidth="160" Margin="0,20,0,0" HorizontalAlignment="Center" Click="OnOpenPlansClick" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border x:Name="MainStatusBarBorder" Grid.Row="2" Grid.ColumnSpan="5" Background="#080C14" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,1,0,0" Padding="14,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="32">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="StatusConnectionText" Text="Connection: —" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                    <StackPanel x:Name="StatusLatencyPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="StatusLatencyText" Text="Latency: —" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                    <StackPanel x:Name="StatusProtocolPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0" Visibility="Collapsed">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="StatusProtocolText" Text="—" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                    <StackPanel x:Name="StatusEncryptionPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0" Visibility="Collapsed">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="StatusEncryptionText" Text="—" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                    <StackPanel x:Name="StatusSessionPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0" Visibility="Collapsed">
                        <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="StatusSessionText" Text="Oturum: 00:00:00" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusAiDot" Width="7" Height="7" Fill="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="StatusAiText" Text="AI: Off" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Toast Notifications -->
        <Grid x:Name="ToastOverlay" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,80" Visibility="Collapsed" IsHitTestVisible="False">
            <Border Background="#1A1F2B" BorderBrush="#3A445C" BorderThickness="1" CornerRadius="12" Padding="20,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="0" Color="Black" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastIcon" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ToastMessage" Text="Reconnecting..." Foreground="#E8ECF4" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Welcome Startup Overlay -->
        <Grid x:Name="WelcomeOverlay"
              Grid.Row="0" Grid.RowSpan="3"
              Grid.Column="0" Grid.ColumnSpan="5"
              Panel.ZIndex="9999"
              Visibility="Collapsed"
              Opacity="0">

            <!-- Glass scrim ? subtle dashboard overlay -->
            <Border Background="#520B0F17" />

            <Border Style="{StaticResource WelcomeGlassCard}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                <!-- Welcome -->
                <Grid Visibility="{Binding IsWelcomePhase, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,22">
                        <TextBlock Text="{Binding GreetingTitle}"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Subtitle}"
                                   FontSize="15"
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Features}" Margin="0,0,0,24">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WelcomeFeatureItem}">
                                <Border Style="{StaticResource WelcomeFeatureItemBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="#14FFFFFF" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding IconGlyph}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="{Binding AccentColor}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="2" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource WelcomeGradientButton}"
                                Content="Start Analysis"
                                Command="{Binding StartDailyAnalysisCommand}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource WelcomeSecondaryButton}"
                                Content="Skip"
                                Command="{Binding SkipWelcomeCommand}" />
                    </Grid>
                </Grid>

                <!-- Loading -->
                <StackPanel Visibility="{Binding IsLoadingPhase, Converter={StaticResource BoolToVis}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            MinWidth="360">
                    <TextBlock Text="Daily analysis"
                               FontSize="13"
                               Foreground="#64748B"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14" />
                    <TextBlock Text="{Binding LoadingMessage}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,0,0,12"
                               TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Progress"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LoadingProgress, Mode=OneWay, StringFormat={}{0:0}%}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#60A5FA"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar Style="{StaticResource WelcomeLoadingProgress}"
                                 Value="{Binding LoadingProgress, Mode=OneWay}"
                                 Margin="0,0,0,18" />
                    <Grid>
                        <Ellipse Width="52" Height="52"
                                 Stroke="#1E293B"
                                 StrokeThickness="4"
                                 HorizontalAlignment="Center" />
                        <Ellipse Width="52" Height="52"
                                 StrokeThickness="4"
                                 HorizontalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0" />
                                    <GradientStop Color="#7C3AED" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="WelcomeSpinnerRotate" Angle="0" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:1.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                            <Ellipse.StrokeDashArray>
                                <DoubleCollection>3.2 1.8</DoubleCollection>
                            </Ellipse.StrokeDashArray>
                        </Ellipse>
                    </Grid>
                </StackPanel>

                <!-- Results / Failed -->
                <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsResultsPhase, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Analysis complete"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ResultSubtitle}"
                                   FontSize="14"
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Background="#0AFFFFFF" CornerRadius="14" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalServers, Mode=OneWay, StringFormat=Toplam sunucu: {0}}"
                                       FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,8" />
                            <WrapPanel>
                                <TextBlock FontSize="13" Foreground="#34D399" Margin="0,0,16,0"
                                           Text="{Binding HealthyCount, Mode=OneWay, StringFormat=Healthy: {0}}" FontWeight="SemiBold" />
                                <TextBlock FontSize="13" Foreground="#F59E0B" Margin="0,0,16,0"
                                           Text="{Binding WarningCount, Mode=OneWay, StringFormat=Warning: {0}}" FontWeight="SemiBold" />
                                <TextBlock FontSize="13" Foreground="#EF4444"
                                           Text="{Binding CriticalCount, Mode=OneWay, StringFormat=Critical: {0}}" FontWeight="SemiBold" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <Border Style="{StaticResource WelcomeResultStatCard}" BorderBrush="#2234D399">
                            <StackPanel>
                                <TextBlock Text="HEALTHY" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                                <TextBlock Text="{Binding HealthyCount, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource WelcomeResultStatCard}" BorderBrush="#22F59E0B">
                            <StackPanel>
                                <TextBlock Text="WARNING" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" />
                                <TextBlock Text="{Binding WarningCount, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource WelcomeResultStatCard}" BorderBrush="#22EF4444">
                            <StackPanel>
                                <TextBlock Text="CRITICAL" FontSize="10" FontWeight="Bold" Foreground="#EF4444" />
                                <TextBlock Text="{Binding CriticalCount, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <StackPanel Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                        <TextBlock Text="Critical Servers" FontSize="12" FontWeight="Bold" Foreground="#F87171" Margin="0,0,0,8"
                                   Visibility="{Binding HasCriticalFindings, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding CriticalFindings}" Margin="0,0,0,14"
                                        Visibility="{Binding HasCriticalFindings, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DailyServerFinding}">
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#FECACA" Margin="0,0,0,6">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Path="ServerName" />
                                                <Binding Path="Summary" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Warnings" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,8"
                                   Visibility="{Binding HasWarningFindings, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding WarningFindings}" Margin="0,0,0,14"
                                        Visibility="{Binding HasWarningFindings, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DailyServerFinding}">
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#FDE68A" Margin="0,0,0,6">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Path="ServerName" />
                                                <Binding Path="Summary" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="#0AFFFFFF" CornerRadius="14" Padding="14"
                                Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Recommendations" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Recommendations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#60A5FA" Margin="0,2,10,0" />
                                                <TextBlock Text="{Binding}" FontSize="13" Foreground="#E2E8F0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource WelcomeSecondaryButton}"
                                Content="{Binding DetailsToggleLabel}"
                                Command="{Binding OpenDetailsCommand}"
                                Visibility="{Binding HasResultLists, Converter={StaticResource BoolToVis}}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource WelcomeGradientButton}"
                                Content="Go to Dashboard"
                                Command="{Binding CloseAnalysisOverlayCommand}" />
                    </Grid>
                </StackPanel>
                </ScrollViewer>

                <StackPanel Visibility="{Binding IsFailedPhase, Converter={StaticResource BoolToVis}}"
                            VerticalAlignment="Center" MinWidth="360">
                    <TextBlock Text="Analysis could not complete"
                               FontSize="24" FontWeight="Bold" Foreground="#F87171" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding FailureMessage}"
                               FontSize="14" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,24" />
                    <Button Style="{StaticResource WelcomeGradientButton}"
                            Content="Go to Dashboard"
                            Command="{Binding CloseAnalysisOverlayCommand}" />
                </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
