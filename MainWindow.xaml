                                                                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE950;" Style="{StaticResource DashInfoSpecIcon}" /><StackPanel Grid.Column="1"><TextBlock Text="Logical CPUs" Style="{StaticResource DashMetaLabel}" /><TextBlock Text="{Binding Text, ElementName=SelectedCpuCountText}" Style="{StaticResource DashMetaValue}" /></StackPanel></Grid>
                                                                        <Grid Margin="0,0,16,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE7C3;" Style="{StaticResource DashInfoSpecIcon}" /><StackPanel Grid.Column="1"><TextBlock Text="Architecture" Style="{StaticResource DashMetaLabel}" /><TextBlock x:Name="ServerOverviewArchitectureText" Text="Not Available" Style="{StaticResource DashMetaValue}" /></StackPanel></Grid>
