                                                                        <Grid Margin="0,0,16,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xEEDA;" Style="{StaticResource DashInfoSpecIcon}" /><StackPanel Grid.Column="1"><TextBlock Text="Disk Capacity" Style="{StaticResource DashMetaLabel}" /><TextBlock x:Name="ServerOverviewDiskCapacityText" Text="Not Available" Style="{StaticResource DashMetaValue}" /></StackPanel></Grid>
                                                                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE7F4;" Style="{StaticResource DashInfoSpecIcon}" /><StackPanel Grid.Column="1"><TextBlock Text="Virtualization" Style="{StaticResource DashMetaLabel}" /><TextBlock x:Name="ServerOverviewVirtualizationText" Text="Not Available" Style="{StaticResource DashMetaValue}" /></StackPanel></Grid>
