                                                                        <Grid Margin="0,0,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE77B;" Style="{StaticResource DashInfoSpecIcon}" /><StackPanel Grid.Column="1"><TextBlock Text="Last User" Style="{StaticResource DashMetaLabel}" /><TextBlock Text="{Binding Text, ElementName=SelectedLastUserText}" Style="{StaticResource DashMetaValue}" /></StackPanel></Grid>
                                                                    </UniformGrid>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>

                                                        <Border Style="{StaticResource DashPanelCard}" Padding="18">
                                                            <StackPanel>
                                                                <TextBlock Text="System Details" Style="{StaticResource DashSectionTitle}" />
