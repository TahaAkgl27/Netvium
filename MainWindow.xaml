                                                                    <Grid Margin="0,0,16,12"><StackPanel><TextBlock Text="Windows Edition" Style="{StaticResource DashMetaLabel}" /><TextBlock Text="{Binding Text, ElementName=SelectedOsText}" Style="{StaticResource DashMetaValue}" TextWrapping="Wrap" /></StackPanel></Grid>
                                                                    <Grid Margin="0,0,16,12"><StackPanel><TextBlock Text="Build Number" Style="{StaticResource DashMetaLabel}" /><TextBlock x:Name="ServerOverviewBuildText" Text="Not Available" Style="{StaticResource DashMetaValue}" /></StackPanel></Grid>
                                                                    <Grid Margin="0,0,16,12"><StackPanel><TextBlock Text="Boot Time" Style="{StaticResource DashMetaLabel}" /><TextBlock x:Name="ServerOverviewBootTimeText" Text="Not Available" Style="{StaticResource DashMetaValue}" /></StackPanel></Grid>
                                                                    <Grid Margin="0,0,0,12"><StackPanel><TextBlock Text="Last Restart" Style="{StaticResource DashMetaLabel}" /><TextBlock Text="{Binding Text, ElementName=DashUptimeText}" Style="{StaticResource DashMetaValue}" /></StackPanel></Grid>
                                                                    <Grid Margin="0,0,16,0"><StackPanel><TextBlock Text="Manufacturer" Style="{StaticResource DashMetaLabel}" /><TextBlock x:Name="ServerOverviewManufacturerText" Text="Not Available" Style="{StaticResource DashMetaValue}" /></StackPanel></Grid>
                                                                    <Grid Margin="0,0,16,0"><StackPanel><TextBlock Text="Model" Style="{StaticResource DashMetaLabel}" /><TextBlock x:Name="ServerOverviewModelText" Text="Not Available" Style="{StaticResource DashMetaValue}" /></StackPanel></Grid>
                                                                    <Grid Margin="0,0,16,0"><StackPanel><TextBlock Text="Machine Type" Style="{StaticResource DashMetaLabel}" /><TextBlock x:Name="ServerOverviewMachineTypeText" Text="Not Available" Style="{StaticResource DashMetaValue}" /></StackPanel></Grid>
                                                                    <Grid><StackPanel><TextBlock Text="Compatibility" Style="{StaticResource DashMetaLabel}" /><TextBlock Text="{Binding Text, ElementName=SelectedCompatibilityText, TargetNullValue=Not Available, FallbackValue=Not Available}" Style="{StaticResource DashMetaValue}" /></StackPanel></Grid>
                                                                </UniformGrid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </ScrollViewer>
                                                <TextBlock x:Name="SelectedCompatibilityText" Visibility="Collapsed" />
                                                <TextBlock x:Name="SelectedLastSessionText" Visibility="Collapsed" />
                                                <ItemsControl x:Name="IpAddressesList" Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                        </Grid>

                                    </Grid>
                                    <!-- Expanded overlay must be outside the collapsed, zero-height legacy grid.
                                         RowSpan must cover the star row so the modal gets a finite height;
                                         otherwise its ScrollViewers measure with infinite space and cannot scroll. -->
                                    <Border x:Name="DashExpandOverlay"
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Visibility="Collapsed"
                                            Background="#D90A1020"
                                            Panel.ZIndex="50"
                                            MouseLeftButtonDown="OnDashExpandOverlayMouseDown">
