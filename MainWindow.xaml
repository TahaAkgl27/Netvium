                                                                    <TextBlock Grid.Row="3" Text="Live adapter throughput" Foreground="#64748B" FontSize="10" Margin="0,8,0,0" />
                                                                </Grid>
                                                            </Border>
                                                        </UniformGrid>

                                                        <Grid Margin="0,0,0,18">
                                                            <Grid.ColumnDefinitions>
