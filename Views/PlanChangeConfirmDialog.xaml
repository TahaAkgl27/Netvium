<Window x:Class="Netvium.Views.PlanChangeConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plan değişikliğini onaylayın" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="#0C1422" BorderBrush="#31425E" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="#101C30" Padding="18,14" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" Background="#1D4ED8" CornerRadius="9" Margin="0,0,10,0">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Plan değişikliğini onaylayın" Foreground="#F1F5F9" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Kullanıcı lisansı güncellenecek" Foreground="#8FA4C4" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="#94A3B8" Background="Transparent"
                            BorderThickness="0" Width="30" Height="30" Click="OnCancelClick"/>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="20">
                <TextBlock Text="SEÇİLİ HESAP" Foreground="#8297B6" FontSize="10" FontWeight="Bold"/>
                <Border Background="#111E32" BorderBrush="#29405F" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,7,0,16">
                    <StackPanel>
                        <TextBlock x:Name="EmailText" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="CurrentPlanText" Foreground="#93A4BD" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#172033" BorderBrush="#2E4770" BorderThickness="1" CornerRadius="10" Padding="13">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#60A5FA" FontSize="17" Margin="0,1,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Yeni plan" Foreground="#8FA4C4" FontSize="11"/>
                            <TextBlock x:Name="NewPlanText" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="16" Margin="0,2,0,0"/>
                            <TextBlock x:Name="DurationText" Foreground="#AFC4DF" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="Bu işlem mevcut aktif lisansı sonlandırır ve yeni planı hemen uygular."
                           Foreground="#7F91AE" TextWrapping="Wrap" FontSize="11" Margin="3,14,3,0"/>
            </StackPanel>
            <Border Grid.Row="2" Background="#0A101A" BorderBrush="#23334C" BorderThickness="0,1,0,0" Padding="16,13">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Vazgeç" Width="105" Height="36" Margin="0,0,9,0" Click="OnCancelClick"
                            Background="#172235" Foreground="#C5D3E6" BorderBrush="#334A6D" BorderThickness="1"/>
                    <Button Content="Planı Değiştir" Width="135" Height="36" Click="OnConfirmClick"
                            Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
