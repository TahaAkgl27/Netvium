<Window x:Class="Netvium.Views.Licensing.PremiumPlusRequiredDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Premium+ Required"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Border CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Background="#0B1322" Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0A101A" Padding="16,14" CornerRadius="16,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#292524" BorderBrush="#92400E" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Premium+ Required" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ModalCloseButton}" Click="OnCloseClick" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="1" Margin="20,16,20,0" Text="Live Screen Reading and AI Guide are available only in Premium+."
                       FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18" />

            <Border Grid.Row="2" Background="#0A101A" Padding="16,14" Margin="0,16,0,0" BorderBrush="#1E293B" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" MinWidth="96" Height="36" Margin="0,0,8,0"
                            Style="{StaticResource FilterTabButton}" Padding="16,8" Click="OnCloseClick" />
                    <Button Content="View Plans" MinWidth="120" Height="36"
                            Style="{StaticResource PrimaryButton}" Padding="16,8" Click="OnViewPlansClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
