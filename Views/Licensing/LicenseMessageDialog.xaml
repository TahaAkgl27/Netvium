<Window x:Class="Netvium.Views.Licensing.LicenseMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activate License"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Border CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Background="#0B1322" Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0A101A" Padding="18,16" CornerRadius="16,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="IconBadge" Width="36" Height="36" CornerRadius="18" Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock x:Name="IconGlyph" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#818CF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="Activate License" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" />
                            <TextBlock x:Name="SubtitleText" Text="Offline activation" FontSize="10" Foreground="#64748B" Margin="0,2,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ModalCloseButton}" Click="OnCloseClick" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,18,20,0">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" Foreground="#CBD5E1" LineHeight="20" />

                <Border x:Name="HintPanel" Margin="0,14,0,0" CornerRadius="10" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" Padding="14,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Code formats" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border CornerRadius="4" Background="#1E1B4B" Padding="6,3" Margin="0,0,8,0">
                                <TextBlock Text="PREMIUM" FontSize="9" FontWeight="Bold" Foreground="#818CF8" />
                            </Border>
                            <TextBlock Text="NTVM-PRM-XXXX-XXXX" FontFamily="Consolas" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="4" Background="#292524" Padding="6,3" Margin="0,0,8,0">
                                <TextBlock Text="PREMIUM+" FontSize="9" FontWeight="Bold" Foreground="#FBBF24" />
                            </Border>
                            <TextBlock Text="NTVM-PLUS-XXXX-XXXX" FontFamily="Consolas" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="2" Background="#0A101A" Padding="18,14" Margin="0,18,0,0" BorderBrush="#1E293B" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16">
                <Button x:Name="ActionButton" Content="Got it" MinWidth="120" Height="38" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButton}" Padding="20,8" Click="OnCloseClick" />
            </Border>
        </Grid>
    </Border>
</Window>
