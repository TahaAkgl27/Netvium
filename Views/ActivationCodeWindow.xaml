<Window x:Class="Netvium.Views.ActivationCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aktivasyon Kodu" Width="590" Height="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0B101A" Foreground="#E8EDF5">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Width="42" Height="42" CornerRadius="12" Background="#173A63" Margin="0,0,13,0">
                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel>
                <TextBlock Text="Aktivasyon kodu oluşturuldu" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Bu kod yalnızca şimdi görüntülenir. Güvenli bir yerde saklayın." Foreground="#8EA0B9" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="TEK KULLANIMLIK KOD" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
            <Border Background="#0E1929" BorderBrush="#31537E" BorderThickness="1" CornerRadius="9" Padding="14,11" Margin="0,8,0,0">
                <TextBox x:Name="CodeBox" Text="{Binding Code, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" Foreground="#BFDBFE" FontFamily="Consolas" FontSize="15"
                         FontWeight="SemiBold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         TextAlignment="Center" ToolTip="Kodu seçip kopyalayabilirsiniz."/>
            </Border>
            <TextBlock x:Name="CopyStatusText" Text="Kodu paylaşmadan önce kopyalayın." Foreground="#71829B" FontSize="11" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource ActionButton}" Click="OnCopyClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                    <TextBlock Text="Kodu Kopyala"/>
                </StackPanel>
            </Button>
            <Button Content="Kapat" Click="OnCloseClick" Margin="10,0,0,0" Padding="16,9"
                    Background="#182235" Foreground="#D6E0EE" BorderBrush="#30415C"/>
        </StackPanel>
    </Grid>
</Window>
