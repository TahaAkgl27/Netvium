<Window x:Class="Netvium.Views.Account.DatabaseConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Netvium • SQL Bağlantısı" Width="600" Height="690"
        MinWidth="560" MinHeight="650" WindowStartupLocation="CenterScreen"
        Background="Transparent" Foreground="#E8EDF5" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B7C2D1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="44"/><Setter Property="Padding" Value="13,0"/>
            <Setter Property="Background" Value="#111A28"/><Setter Property="Foreground" Value="#E8EDF5"/>
            <Setter Property="BorderBrush" Value="#26354B"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#A5B4FC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#3A4C68"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#5B7CFA"/>
                                <Setter TargetName="FieldBorder" Property="Background" Value="#131F32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/><Setter Property="Padding" Value="13,0"/>
            <Setter Property="Background" Value="#111A28"/><Setter Property="Foreground" Value="#E8EDF5"/>
            <Setter Property="BorderBrush" Value="#26354B"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#3A4C68"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#5B7CFA"/>
                                <Setter TargetName="FieldBorder" Property="Background" Value="#131F32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE5F2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                    Background="#111A28" BorderBrush="#3A4C68" BorderThickness="1"
                                    Margin="0,0,9,0">
                                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#4F73FF"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#7290FF"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#8EA8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/><Setter Property="Background" Value="#4F73FF"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#6283FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3D60E8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/><Setter Property="Background" Value="#172235"/>
            <Setter Property="Foreground" Value="#DCE5F2"/><Setter Property="BorderBrush" Value="#2B3B52"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#202E45"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#466183"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#080E18" BorderBrush="#243044" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#0D1522" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="18" Height="18" CornerRadius="5" Background="#5B7CFA" Margin="0,0,8,0">
                        <Image Source="pack://application:,,,/NetviumLogo.png" Width="12" Height="12"/>
                    </Border>
                    <TextBlock Text="SQL Bağlantısı" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                        Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                        ToolTip="Küçült" Click="OnMinimizeClick"/>
                <Button Grid.Column="2" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                        Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                        ToolTip="Kapat" Click="OnCloseClick"/>
            </Grid>
            <Grid Grid.Row="1" Margin="24">
        <Border CornerRadius="20" Background="#0D1522" BorderBrush="#202D40" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity=".3" Color="#000000"/>
            </Border.Effect>
            <Grid Margin="34,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="14" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5B7CFA" Offset="0"/>
                                <GradientStop Color="#7C3AED" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="SQL Server Bağlantısı" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="NetviumIdentity için veri kaynağını yapılandırın"
                                   Foreground="#8492A6" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#111A28" BorderBrush="#202D40" BorderThickness="1"
                        CornerRadius="10" Margin="0,22,0,20" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#8EA8FF" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="Bağlantı bilgileri yalnızca bu Windows kullanıcısı için şifrelenerek saklanır."
                                   FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="SUNUCU BİLGİLERİ" Foreground="#64748B" FontSize="10"
                                   FontWeight="Bold" Margin="0,0,0,14"/>

                        <TextBlock Text="Sunucu / Instance" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ServerBox" Text="tcp:&lt;sql-host&gt;,1433"
                                 ToolTip="Örnek: &lt;server&gt;\SQLEXPRESS"/>
                        <TextBlock Text="Örnek: &lt;server&gt;\SQLEXPRESS" Foreground="#75849A"
                                   FontSize="11" Margin="1,6,0,17"/>

                        <TextBlock Text="Veritabanı" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DatabaseBox" Text="NetviumIdentity"/>

                        <Border Height="1" Background="#202D40" Margin="0,22,0,18"/>
                        <TextBlock Text="KİMLİK DOĞRULAMA" Foreground="#64748B" FontSize="10"
                                   FontWeight="Bold" Margin="0,0,0,13"/>

                        <CheckBox x:Name="WindowsAuthCheckBox" Content="Windows kimlik doğrulamasını kullan"
                                  Margin="0,0,0,15" IsChecked="False" Checked="OnAuthenticationChanged"
                                  Unchecked="OnAuthenticationChanged"/>

                        <Grid x:Name="SqlCredentialsPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SQL kullanıcı adı" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="UserNameBox" Text="sa"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SQL parolası" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="SqlPasswordBox"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="TrustCertificateCheckBox" Content="Sunucunun yerel sertifikasına güven"
                                  Margin="0,20,0,0" IsChecked="True"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Margin="0,20,0,0">
                    <Border x:Name="StatusPanel" Background="#111A28" BorderBrush="#26354B" BorderThickness="1" CornerRadius="9"
                            Padding="11,9" Margin="0,0,0,14">
                        <TextBlock x:Name="StatusText" MinHeight="18" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="#8492A6" FontSize="11"
                                   Text="Bağlantıyı test ederek ayarları doğrulayın."/>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TestButton" Content="Bağlantıyı Test Et"
                                Style="{StaticResource SecondaryButton}" Click="OnTestClick"/>
                        <Button x:Name="SaveButton" Grid.Column="2" Content="Kaydet ve Devam Et"
                                Style="{StaticResource PrimaryButton}" Click="OnSaveClick"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
