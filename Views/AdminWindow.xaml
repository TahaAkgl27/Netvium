<Window x:Class="Netvium.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin License Console" Width="1220" Height="800"
        MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#090E18" Foreground="#E8EDF5">
    <Window.Resources>
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#121A29"/>
            <Setter Property="BorderBrush" Value="#243148"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#E8EDF5"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0E1625"/>
            <Setter Property="Foreground" Value="#D9E2F0"/>
            <Setter Property="BorderBrush" Value="#243148"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#0E1625"/>
            <Setter Property="AlternatingRowBackground" Value="#111C2D"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1C2A3D"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#172338"/>
            <Setter Property="Foreground" Value="#8EA8CC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#243148"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#D9E2F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#D9E2F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A2A42"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#243B61"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="Foreground" Value="#E8EDF5"/>
            <Setter Property="BorderBrush" Value="#31425E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="Foreground" Value="#E8EDF5"/>
            <Setter Property="BorderBrush" Value="#31425E"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" Background="#1E3A5F" CornerRadius="12" Margin="0,0,13,0">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Admin License Console" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Hesap, lisans, aktivasyon ve kullanım yönetimi" Foreground="#7F91AE" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryActionButton}" Click="OnRefreshClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                    <TextBlock Text="Yenile"/>
                </StackPanel>
            </Button>
        </Grid>
        <Border Grid.Row="1" Background="#101827" BorderBrush="#243148" BorderThickness="1" CornerRadius="14" Margin="0,22,0,16" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2.8*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel><TextBlock Text="TOPLAM HESAP" Foreground="#71829B" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="TotalUsersText" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                    <StackPanel><TextBlock Text="AKTİF HESAP" Foreground="#71829B" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="ActiveUsersText" FontSize="25" FontWeight="SemiBold" Foreground="#86EFAC" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel><TextBlock Text="ÜCRETLİ PLAN" Foreground="#71829B" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="PremiumUsersText" FontSize="25" FontWeight="SemiBold" Foreground="#C4B5FD" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricCard}">
                    <StackPanel><TextBlock Text="AKTİF CİHAZ" Foreground="#71829B" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DevicesText" FontSize="25" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="4" Background="#0B1321" BorderBrush="#2A3A54" BorderThickness="1" CornerRadius="10" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="YENİ AKTİVASYON KODU" Foreground="#93A4BD" FontSize="10" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ComboBox x:Name="PlanBox" Width="145" SelectedIndex="0"><ComboBoxItem Content="PREMIUM"/><ComboBoxItem Content="PREMIUM_PLUS"/></ComboBox>
                            <TextBox x:Name="DurationDaysBox" Width="72" Margin="8,0,0,0" Text="30" ToolTip="Premium süresi (gün)" />
                            <TextBox x:Name="TokenNoteBox" Width="170" Margin="8,0,0,0" Text="Not (isteğe bağlı)"/>
                            <Button Style="{StaticResource PrimaryActionButton}" Content="Kod Üret" Click="OnIssueTokenClick" Margin="8,0,0,0" Padding="13,7"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="#0E1625" BorderBrush="#243148" BorderThickness="1" CornerRadius="12" Padding="8">
        <TabControl Background="Transparent" BorderThickness="0">
            <TabItem Header="Kullanıcılar">
                <Grid Margin="5">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="#101C30" BorderBrush="#2A3D5C" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SEÇİLİ KULLANICI" Foreground="#8297B6" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="SelectedUserText" Text="Bir kullanıcı seçin" Foreground="#E8EDF5" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="YENİ PLAN" Foreground="#8297B6" FontSize="10" FontWeight="Bold"/>
                                <ComboBox x:Name="UserPlanBox" SelectedIndex="0" Margin="0,4,0,0">
                                    <ComboBoxItem Content="FREE"/>
                                    <ComboBoxItem Content="PREMIUM"/>
                                    <ComboBoxItem Content="PREMIUM_PLUS"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="SÜRE / GÜN" Foreground="#8297B6" FontSize="10" FontWeight="Bold"/>
                                <TextBox x:Name="UserPlanDurationBox" Text="30" Margin="0,4,0,0" ToolTip="FREE plan için kullanılmaz"/>
                            </StackPanel>
                            <Button Grid.Column="3" Style="{StaticResource PrimaryActionButton}" Content="Planı Uygula" Click="OnChangeUserPlanClick" Margin="12,17,0,0" Padding="16,8"/>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="UsersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              SelectionChanged="OnUserSelectionChanged" Background="#0F1726" Foreground="#E8EDF5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KULLANICI" Binding="{Binding DisplayName}" Width="1.1*"/>
                            <DataGridTextColumn Header="E-POSTA" Binding="{Binding Email}" Width="1.7*"/>
                            <DataGridTextColumn Header="PLAN" Binding="{Binding PlanDisplayName}" Width="*"/>
                            <DataGridTextColumn Header="KALAN SÜRE" Binding="{Binding RemainingPlanTime}" Width="*"/>
                            <DataGridTextColumn Header="BİTİŞ (UTC)" Binding="{Binding LicenseExpiresAtUtc, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="1.2*"/>
                            <DataGridTextColumn Header="CİHAZ" Binding="{Binding DeviceCount}" Width="70"/>
                            <DataGridCheckBoxColumn Header="YÖNETİCİ" Binding="{Binding IsAdmin}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Aktivasyon Kodları">
                <DataGrid x:Name="TokensGrid" AutoGenerateColumns="True" IsReadOnly="True" Background="#0F1726" Foreground="#E8EDF5"/>
            </TabItem>
            <TabItem Header="Kullanım">
                <DataGrid x:Name="UsageGrid" AutoGenerateColumns="True" IsReadOnly="True" Background="#0F1726" Foreground="#E8EDF5"/>
            </TabItem>
            <TabItem Header="Denetim">
                <DataGrid x:Name="AuditGrid" AutoGenerateColumns="True" IsReadOnly="True" Background="#0F1726" Foreground="#E8EDF5"/>
            </TabItem>
        </TabControl>
        </Border>
    </Grid>
</Window>
