<UserControl x:Class="Netvium.Views.Dashboard.DashboardWorkspaceHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True"
             Background="Transparent">
    <Grid>
        <Canvas x:Name="GridCanvas" ClipToBounds="True">
            <Canvas x:Name="GridGuideLayer" IsHitTestVisible="False" Visibility="Collapsed" />
            <Rectangle x:Name="DropPlaceholder"
                       RadiusX="16"
                       RadiusY="16"
                       Fill="#224F8CFF"
                       Stroke="#4F8CFF"
                       StrokeThickness="2"
                       StrokeDashArray="6 4"
                       Visibility="Collapsed"
                       IsHitTestVisible="False" />
            <Canvas x:Name="WidgetLayer" />
        </Canvas>
    </Grid>
</UserControl>
