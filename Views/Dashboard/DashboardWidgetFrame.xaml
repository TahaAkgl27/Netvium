<UserControl x:Class="Netvium.Views.Dashboard.DashboardWidgetFrame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboard="clr-namespace:Netvium.ViewModels.Dashboard"
             ClipToBounds="False"
             Focusable="True">
    <Border x:Name="ChromeRoot"
            Background="Transparent"
            BorderBrush="#1E2A3F"
            BorderThickness="1"
            CornerRadius="14"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Rectangle x:Name="EditOutline"
                       Grid.RowSpan="2"
                       RadiusX="14"
                       RadiusY="14"
                       Stroke="#4F8CFF"
                       StrokeThickness="1.5"
                       StrokeDashArray="4 3"
                       Visibility="Collapsed"
                       IsHitTestVisible="False" />

            <Border x:Name="HeaderBar"
                    Grid.Row="0"
                    Background="#141D30"
                    BorderBrush="#1E2A3F"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    Cursor="Arrow">
                <DockPanel Margin="12,0" LastChildFill="True">
                    <StackPanel x:Name="ActionButtonsPanel"
                                DockPanel.Dock="Right"
                                Orientation="Horizontal">
                        <Button x:Name="ExpandBtn"
                                Style="{StaticResource DashWidgetChromeButton}"
                                Content="&#xE740;"
                                ToolTip="Expand widget"
                                Click="OnExpandClick" />
                        <StackPanel x:Name="EditActionsPanel"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <Button x:Name="PinBtn" Style="{StaticResource DashWidgetChromeButton}" Content="&#xE718;" ToolTip="Pin" Click="OnPinClick" />
                            <Button x:Name="SettingsBtn" Style="{StaticResource DashWidgetChromeButton}" Content="&#xE713;" ToolTip="Settings" Click="OnSettingsClick" />
                            <Button x:Name="DuplicateBtn" Style="{StaticResource DashWidgetChromeButton}" Content="&#xE8C8;" ToolTip="Duplicate" Click="OnDuplicateClick" />
                            <Button x:Name="RemoveBtn" Style="{StaticResource DashWidgetChromeButton}" Content="&#xE74D;" ToolTip="Remove" Click="OnRemoveClick" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="DragHandleArea"
                                Orientation="Horizontal"
                                VerticalAlignment="Stretch"
                                MinWidth="120"
                                Background="Transparent">
                        <TextBlock x:Name="DragGlyph"
                                   Text="&#xE700;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="#64748B"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="TitleIcon" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#4F8CFF" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TitleText" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid x:Name="ContentHost"
                  Grid.Row="1"
                  ClipToBounds="True" />

            <Grid x:Name="ResizeHandlesLayer"
                  Grid.RowSpan="2"
                  Visibility="Collapsed"
                  IsHitTestVisible="True">
                <Thumb Tag="N" Height="16" HorizontalAlignment="Stretch" VerticalAlignment="Top" Cursor="SizeNS" Opacity="0" DragStarted="OnResizeDragStarted" DragDelta="OnResizeDragDelta" DragCompleted="OnResizeDragCompleted" />
                <Thumb Tag="S" Height="16" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Cursor="SizeNS" Opacity="0" DragStarted="OnResizeDragStarted" DragDelta="OnResizeDragDelta" DragCompleted="OnResizeDragCompleted" />
                <Thumb Tag="W" Width="16" HorizontalAlignment="Left" VerticalAlignment="Stretch" Cursor="SizeWE" Opacity="0" DragStarted="OnResizeDragStarted" DragDelta="OnResizeDragDelta" DragCompleted="OnResizeDragCompleted" />
                <Thumb Tag="E" Width="16" HorizontalAlignment="Right" VerticalAlignment="Stretch" Cursor="SizeWE" Opacity="0" DragStarted="OnResizeDragStarted" DragDelta="OnResizeDragDelta" DragCompleted="OnResizeDragCompleted" />
                <Thumb Tag="NW" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Opacity="0" DragStarted="OnResizeDragStarted" DragDelta="OnResizeDragDelta" DragCompleted="OnResizeDragCompleted" />
                <Thumb Tag="NE" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Opacity="0" DragStarted="OnResizeDragStarted" DragDelta="OnResizeDragDelta" DragCompleted="OnResizeDragCompleted" />
                <Thumb Tag="SW" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Opacity="0" DragStarted="OnResizeDragStarted" DragDelta="OnResizeDragDelta" DragCompleted="OnResizeDragCompleted" />
                <Thumb Tag="SE" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragStarted="OnResizeDragStarted" DragDelta="OnResizeDragDelta" DragCompleted="OnResizeDragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Path Data="M 18 4 L 18 18 L 4 18"
                                      Stroke="#4F8CFF"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,4,4" />
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Grid>
    </Border>
</UserControl>
