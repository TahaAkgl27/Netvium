<Window x:Class="Netvium.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Netvium.ViewModels"
        xmlns:settings="clr-namespace:Netvium.ViewModels.Settings"
        xmlns:helpers="clr-namespace:Netvium.Helpers"
        Title="Settings"
        Width="980"
        Height="700"
        MinWidth="860"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="CanResize">

    <Window.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <DataTemplate DataType="{x:Type settings:BoolSettingRowViewModel}">
            <Border Style="{StaticResource SettingsRowCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource SettingsRowDescription}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource SettingsToggleSwitch}" IsChecked="{Binding Value, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type settings:ChoiceSettingRowViewModel}">
            <Border Style="{StaticResource SettingsRowCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SettingsRowTitle}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource SettingsRowDescription}" />
                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedValue, Mode=TwoWay}"
                              Style="{StaticResource SettingsComboBox}" Margin="0,10,0,0" MinWidth="220" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type settings:TextSettingRowViewModel}">
            <Border Style="{StaticResource SettingsRowCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SettingsRowTitle}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource SettingsRowDescription}" />
                    <Grid Margin="0,10,0,0">
                        <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="34">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource SearchBox}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPassword}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <PasswordBox helpers:PasswordBoxHelper.BindPassword="True"
                                     helpers:PasswordBoxHelper.BoundPassword="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34" Padding="10,0" Background="#0E1420" Foreground="#E2E8F0" BorderBrush="#243044">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPassword}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type settings:NumberSettingRowViewModel}">
            <Border Style="{StaticResource SettingsRowCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SettingsRowTitle}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource SettingsRowDescription}" />
                    <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchBox}" Margin="0,10,0,0" Width="120" HorizontalAlignment="Left" Height="34" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type settings:SliderSettingRowViewModel}">
            <Border Style="{StaticResource SettingsRowCard}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock Text="{Binding Value, StringFormat={}{0:0}}" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource SettingsRowDescription}" />
                    <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value, Mode=TwoWay}"
                            Margin="0,10,0,0" Style="{StaticResource SettingsSlider}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type settings:InfoSettingRowViewModel}">
            <Border Style="{StaticResource SettingsRowCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SettingsRowTitle}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource SettingsRowDescription}" />
                    <TextBlock Text="{Binding Value}" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type settings:ActionSettingRowViewModel}">
            <Border Style="{StaticResource SettingsRowCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource SettingsRowDescription}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding ButtonText}" Command="{Binding Command}" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                        <Setter Property="Foreground" Value="#FCA5A5" />
                                        <Setter Property="BorderBrush" Value="#7F1D1D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type settings:LicenseActivationSettingRowViewModel}">
            <Border Style="{StaticResource SettingsRowCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SettingsRowTitle}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource SettingsRowDescription}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Current Status" Style="{StaticResource SettingsRowDescription}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                    </Grid>
                    <TextBox Text="{Binding ActivationCode, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchBox}" Height="38" Margin="0,14,0,0"
                             Tag="Enter Activation Code" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Activate" Padding="18,8"
                                Command="{Binding ActivateCommand}" MinWidth="120" />
                    </StackPanel>
                    <TextBlock Text="{Binding FeedbackText}" FontSize="11" Foreground="#94A3B8" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource TopBarBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="{Binding UnsavedIndicator}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBox Grid.Column="1" Style="{StaticResource SearchBox}" Height="36"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="SearchSettings" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Nav -->
            <Border Background="#0D1119" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="10,12">
                <ListBox ItemsSource="{Binding Categories}" SelectedValuePath="Category"
                         SelectedValue="{Binding SelectedCategory, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SettingsNavItemStyle}" />
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,16">
                    <ItemsControl ItemsSource="{Binding FilteredRows}" />
                </ScrollViewer>
                <Border Background="#800B0F17" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Saving..." Foreground="#94A3B8" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#0A101A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource TabButton}" Content="Restore Defaults" Command="{Binding RestoreDefaultsCommand}" Padding="14,8" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource TabButton}" Content="Cancel" Command="{Binding CancelCommand}" Padding="18,8" Margin="0,0,8,0" MinWidth="100" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Save" Command="{Binding SaveCommand}" Padding="22,8" MinWidth="120" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
