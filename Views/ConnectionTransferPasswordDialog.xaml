<Window x:Class="Netvium.Views.ConnectionTransferPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bağlantı Aktarım Parolası"
        Width="460"
        Height="330"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeadingText" Text="Aktarım parolası" FontSize="19" FontWeight="SemiBold" Foreground="White" />
            <TextBlock x:Name="DescriptionText" Margin="0,8,0,0" Foreground="#94A3B8" FontSize="12"
                       TextWrapping="Wrap" LineHeight="18" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Parola" Margin="0,20,0,6" Foreground="#CBD5E1" FontSize="12" />
        <PasswordBox x:Name="PasswordInput" Grid.Row="2" Height="38" Padding="10,7" MaxLength="256"
                     Background="#111827" Foreground="White" BorderBrush="#334155" BorderThickness="1"
                     PasswordChanged="OnPasswordChanged" />

        <StackPanel x:Name="ConfirmationPanel" Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Parolayı tekrar girin" Margin="0,0,0,6" Foreground="#CBD5E1" FontSize="12" />
            <PasswordBox x:Name="ConfirmationInput" Height="38" Padding="10,7" MaxLength="256"
                         Background="#111827" Foreground="White" BorderBrush="#334155" BorderThickness="1"
                         PasswordChanged="OnPasswordChanged" />
        </StackPanel>

        <TextBlock x:Name="ValidationText" Grid.Row="4" Margin="0,12,0,0" Foreground="#FCA5A5"
                   FontSize="11" TextWrapping="Wrap" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="İptal" Style="{StaticResource TabButton}" Padding="18,8" MinWidth="92"
                    IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton" Content="Devam" Style="{StaticResource PrimaryButton}" Padding="18,8"
                    MinWidth="110" IsDefault="True" Click="OnConfirmClick" />
        </StackPanel>
    </Grid>
</Window>
