<Window x:Class="Netvium.QuickScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Scan"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#0D1520"
        BorderBrush="#1E3A5F" BorderThickness="1"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- RowItem DataTemplate helper styles -->
        <Style x:Key="ScanRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" BorderBrush="#1E3A5F" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0D1520" Offset="0"/>
                <GradientStop Color="#111827" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- title bar -->
                <RowDefinition Height="Auto"/>  <!-- header -->
                <RowDefinition Height="Auto"/>  <!-- checks -->
                <RowDefinition Height="Auto"/>  <!-- footer -->
                <RowDefinition Height="Auto"/>  <!-- close btn -->
            </Grid.RowDefinitions>

            <!-- Drag Bar -->
            <Border Grid.Row="0" Background="#0A1220" Padding="16,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TitleLabel" Text="Quick Scan" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Width="28" Height="28" Background="Transparent"
                            BorderThickness="0" Foreground="#64748B" FontSize="14" Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#991B1B"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Server Header Banner -->
            <Border Grid.Row="1" Padding="20,14" Margin="12,8,12,0" CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E3A5F" Offset="0"/>
                        <GradientStop Color="#1A2D4F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="🖥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock x:Name="ServerNameLabel" Text="WebApp" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <TextBlock x:Name="ServerIpLabel" Text="192.168.1.1" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border x:Name="OverallBadge" Margin="16,0,0,0" Padding="10,4" CornerRadius="8" VerticalAlignment="Center" Background="#14532D">
                        <TextBlock x:Name="OverallBadgeText" Text="SAĞLIKLI" FontSize="11" FontWeight="Bold" Foreground="#4ADE80"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Check Items -->
            <ItemsControl Grid.Row="2" x:Name="ChecksList" Margin="12,10,12,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="14,10" CornerRadius="8" Background="{Binding RowBackground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <TextBlock Text="{Binding Label}" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{Binding DetailColor}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="2" Padding="8,3" CornerRadius="6" VerticalAlignment="Center" Background="{Binding BadgeBg}" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding BadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding BadgeFg}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Footer Summary -->
            <Border Grid.Row="3" Margin="12,10,12,0" Padding="16,12" CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E293B" Offset="0"/>
                        <GradientStop Color="#172033" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="CheckCountText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                        <TextBlock Text="Kontrol" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="RiskCountText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Center"/>
                        <TextBlock Text="Risk" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Close Button -->
            <Border Grid.Row="4" Margin="12,10,12,16">
                <Button x:Name="OkButton" Content="Kapat" Height="40" Background="#1E40AF" Foreground="White"
                        FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#1E40AF" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
