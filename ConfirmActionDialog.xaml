<Window x:Class="Netvium.ConfirmActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onay"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Border CornerRadius="16" BorderThickness="1" ClipToBounds="True" x:Name="RootBorder">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B0F17" Offset="0" />
                <GradientStop Color="#121826" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#0A101A" Padding="16,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="TitleIconBadge" Width="28" Height="28" CornerRadius="8" Margin="0,0,10,0">
                            <TextBlock x:Name="TitleIconText" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                        </Border>
                        <TextBlock x:Name="TitleText" Text="Onay" FontWeight="SemiBold" FontSize="14" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Width="30" Height="30"
                            Background="Transparent" BorderThickness="0" Foreground="#64748B" FontSize="11" Cursor="Hand"
                            Click="CancelButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1F2937" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="20,16,20,8">
                <Border Background="#0E1420" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ServerIconBadge" Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
                            <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ServerNameText" Text="Sunucu" FontWeight="SemiBold" FontSize="15" Foreground="White" />
                            <TextBlock x:Name="ServerIpText" Text="0.0.0.0" FontSize="12" Foreground="#60A5FA" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="WarningBanner" CornerRadius="10" Padding="12,10" Margin="0,0,0,14" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="WarningIconText" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   VerticalAlignment="Top" Margin="0,1,10,0" />
                        <StackPanel>
                            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" Foreground="#E2E8F0" LineHeight="20" />
                            <TextBlock Text="Bu işlem geri alınamaz." FontSize="11" Foreground="#64748B" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Actions -->
            <Border Grid.Row="2" Background="#0A101A" Padding="16,14" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="Vazgeç" MinWidth="100" Height="36" Margin="0,0,8,0"
                            Background="#151C28" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1"
                            FontSize="12" Cursor="Hand" Click="CancelButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="16,8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1F2937" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="ConfirmButton" Grid.Column="2" Content="Onayla" MinWidth="130" Height="36"
                            Foreground="White" BorderThickness="0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                            Click="ConfirmButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="18,8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
